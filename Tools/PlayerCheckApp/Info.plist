<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.autohush.tools.playercheck</string>
    <key>CFBundleName</key>
    <string>Player Check</string>
    <key>CFBundleExecutable</key>
    <string>PlayerCheckApp</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSAppleEventsUsageDescription</key>
    <string>Player Check reads a player's state by AppleScript and, in its test, pauses it and plays it again.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>Player Check measures how loud an app is, to tell whether it plays, as AutoHush does. Audio is never recorded, stored or sent anywhere.</string>
</dict>
</plist>
