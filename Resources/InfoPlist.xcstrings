    "NSAppleEventsUsageDescription" : {
      "comment" : "Shown when macOS asks whether AutoHush may control the music player",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AutoHush pauses and resumes Spotify."
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription" : {
      "comment" : "Shown when macOS asks whether AutoHush may record system audio",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AutoHush measures how loud other apps are, so it only pauses your music for audible sound. Audio is never recorded, stored or sent anywhere."
          }
        }
      }
    },
    "NSHumanReadableCopyright" : {
