{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "Shown when macOS asks whether AutoHush may control the media player",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقف AutoHush مشغّل الوسائط لديك مؤقتًا ثم يستأنفه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’AutoHush posa en pausa i reprèn el teu reproductor multimèdia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pozastavuje a obnovuje váš přehrávač médií."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush sætter din medieafspiller på pause og genoptager den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pausiert deinen Medienplayer und setzt die Wiedergabe fort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το AutoHush θέτει σε παύση και συνεχίζει την εφαρμογή πολυμέσων σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AutoHush pauses and resumes your media player."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pausa y reanuda tu reproductor multimedia."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pausa y reanuda tu reproductor multimedia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush keskeyttää mediasoittimesi ja jatkaa sen toistoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush met votre lecteur multimédia en pause et relance la lecture."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush met votre lecteur multimédia en pause et relance la lecture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush משהה ומחדש את נגן המדיה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush आपके मीडिया प्लेयर को पॉज़ करता है और फिर से शुरू करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pauzira i nastavlja vaš medijski reproduktor."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az AutoHush szünetelteti és folytatja a médialejátszóját."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush menjeda dan melanjutkan pemutar media Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mette in pausa e riprende il tuo lettore multimediale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHushはメディアプレーヤーを一時停止して再開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush가 미디어 플레이어를 일시 정지하고 다시 재생합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush menjeda dan menyambung semula pemain media anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush setter mediespilleren din på pause og gjenopptar den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pauzeert en hervat je mediaspeler."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush wstrzymuje i wznawia Twój odtwarzacz multimediów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush pausa e retoma seu player de mídia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush pausa e retoma o seu leitor multimédia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pune pe pauză și reia playerul dvs. media."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ставит ваш медиаплеер на паузу и возобновляет воспроизведение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pozastavuje a obnovuje váš prehrávač médií."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush zaustavi in nadaljuje vaš predvajalnik predstavnosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pausar och återupptar din mediaspelare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush จะหยุดพักและเล่นตัวเล่นสื่อของคุณต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush medya oynatıcınızı duraklatır ve sürdürür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush призупиняє й відновлює ваш медіапрогравач."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush tạm dừng và tiếp tục trình phát đa phương tiện của bạn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 會暫停並恢復你的媒體播放器。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 会暂停并恢复你的媒体播放器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 會暫停並恢復你的媒體播放器。"
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription" : {
      "comment" : "Shown when macOS asks whether AutoHush may record system audio: it measures how loud the media player and other apps are, and mutes the player through it",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقيس AutoHush ارتفاع صوت مشغّلك والتطبيقات الأخرى، حتى لا يوقف مؤقتًا أو يكتم إلا ما يُسمع. لا يُسجَّل الصوت أو يُخزَّن أو يُرسَل إلى أي مكان أبدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’AutoHush mesura el volum del reproductor i de les altres apps per posar en pausa o silenciar només el que se sent. L’àudio no es grava, no es desa ni s’envia enlloc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush měří, jak hlasitě hraje váš přehrávač a jiné aplikace, aby pozastavil nebo ztlumil jen to, co je slyšet. Zvuk se nikdy nenahrává, neukládá ani nikam neposílá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush måler, hvor høje din afspiller og andre apps er, så den kun sætter det, der kan høres, på pause eller slår lyden fra. Lyd bliver aldrig optaget, gemt eller sendt nogen steder hen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush misst, wie laut dein Player und andere Apps sind, damit nur pausiert oder stummgeschaltet wird, was zu hören ist. Audio wird nie aufgenommen, gespeichert oder irgendwohin gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το AutoHush μετρά πόσο δυνατά ακούγονται η εφαρμογή αναπαραγωγής σας και άλλες εφαρμογές, ώστε να θέτει σε παύση ή σίγαση μόνο ό,τι ακούγεται. Ο ήχος δεν εγγράφεται, δεν αποθηκεύεται και δεν αποστέλλεται ποτέ πουθενά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AutoHush measures how loud your player and other apps are, to pause or mute only what’s heard. Audio is never recorded, stored or sent anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mide el volumen de tu reproductor y de las demás apps para pausar o silenciar solo lo que se oye. El audio nunca se graba, se guarda ni se envía a ningún sitio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mide el volumen de tu reproductor y de las demás apps para pausar o silenciar solo lo que se oye. El audio nunca se graba, se guarda ni se envía a ninguna parte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mittaa, kuinka kovaa soittimesi ja muut apit soivat, jotta se keskeyttää tai mykistää vain sen, mikä kuuluu. Ääntä ei koskaan tallenneta, säilytetä eikä lähetetä minnekään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mesure le volume de votre lecteur et des autres apps afin de ne mettre en pause ou en sourdine que ce qui s’entend. L’audio n’est jamais enregistré, conservé ni envoyé où que ce soit."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mesure le volume de votre lecteur et des autres apps afin de ne mettre en pause ou en sourdine que ce qui s’entend. L’audio n’est jamais enregistré, conservé ni envoyé où que ce soit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush מודד את עוצמת הקול של הנגן שלך ושל אפליקציות אחרות, כדי להשהות או להשתיק רק את מה שנשמע. השמע אף פעם לא מוקלט, נשמר או נשלח לשום מקום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush मापता है कि आपका प्लेयर और दूसरे ऐप्स कितनी तेज़ आवाज़ में हैं, ताकि वह सिर्फ़ सुनाई देने वाली चीज़ को ही पॉज़ या म्यूट करे। ऑडियो कभी रिकॉर्ड, संग्रहीत या कहीं भेजा नहीं जाता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mjeri koliko su glasni vaš reproduktor i druge aplikacije, kako bi pauzirao ili utišao samo ono što se čuje. Zvuk se nikad ne snima, ne pohranjuje i nikamo ne šalje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az AutoHush méri, milyen hangos a lejátszója és más appok, hogy csak azt szüneteltesse vagy némítsa el, ami hallható. A hang soha nem kerül rögzítésre, tárolásra vagy továbbításra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mengukur seberapa keras pemutar Anda dan app lain, sehingga hanya menjeda atau membisukan yang terdengar. Audio tidak pernah direkam, disimpan, atau dikirim ke mana pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush misura il volume del lettore e delle altre app per mettere in pausa o silenziare solo ciò che si sente. L’audio non viene mai registrato, salvato né inviato altrove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHushはプレーヤーとほかのAppの音量を測定し、実際に聞こえているものだけを一時停止または消音します。オーディオが録音、保存、送信されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush는 플레이어와 다른 앱의 소리 크기를 측정하여 실제로 들리는 것만 일시 정지하거나 음소거합니다. 오디오는 녹음되거나 저장되거나 어디로도 전송되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mengukur kekuatan bunyi pemain anda dan app lain, supaya ia hanya menjeda atau meredamkan apa yang kedengaran. Audio tidak pernah dirakam, disimpan atau dihantar ke mana-mana."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush måler hvor høye spilleren din og andre apper er, slik at den bare setter på pause eller demper det som høres. Lyd blir aldri tatt opp, lagret eller sendt noe sted."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush meet hoe luid je speler en andere apps zijn, zodat het alleen pauzeert of dempt wat hoorbaar is. Audio wordt nooit opgenomen, bewaard of ergens naartoe gestuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mierzy głośność Twojego odtwarzacza i innych aplikacji, aby wstrzymywać lub wyciszać tylko to, co słychać. Dźwięk nigdy nie jest nagrywany, przechowywany ani nigdzie wysyłany."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush mede o volume do seu player e dos outros apps para só pausar ou silenciar o que se ouve. O áudio nunca é gravado, armazenado nem enviado a lugar algum."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush mede o volume do seu leitor e das outras apps para só pausar ou silenciar o que se ouve. O áudio nunca é gravado, guardado nem enviado para lado nenhum."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush măsoară volumul playerului și al altor aplicații, ca să pună pe pauză sau să dezactiveze sunetul doar pentru ce se aude. Sunetul nu este niciodată înregistrat, stocat sau trimis nicăieri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush измеряет громкость вашего плеера и других приложений, чтобы ставить на паузу или выключать звук только того, что слышно. Звук никогда не записывается, не сохраняется и никуда не отправляется."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush meria, ako nahlas hrá váš prehrávač a iné apky, aby pozastavil alebo stlmil len to, čo počuť. Zvuk sa nikdy nenahráva, neukladá ani nikam neposiela."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush meri, kako glasni so vaš predvajalnik in druge aplikacije, da zaustavi ali utiša samo tisto, kar se sliši. Zvok se nikoli ne snema, shranjuje ali kam pošilja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mäter hur höga din spelare och andra appar är, så att den bara pausar eller tystar det som hörs. Ljud spelas aldrig in, sparas eller skickas någonstans."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush จะวัดความดังของตัวเล่นของคุณและแอปอื่น เพื่อหยุดพักหรือปิดเสียงเฉพาะสิ่งที่ได้ยินเท่านั้น เสียงจะไม่ถูกบันทึก จัดเก็บ หรือส่งไปที่ใดเลย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush, yalnızca duyulanı duraklatmak veya sessize almak için oynatıcınızın ve diğer uygulamaların ses yüksekliğini ölçer. Ses hiçbir zaman kaydedilmez, saklanmaz veya bir yere gönderilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush вимірює, наскільки гучні ваш програвач та інші програми, щоб призупиняти або вимикати звук лише того, що чути. Звук ніколи не записується, не зберігається й нікуди не надсилається."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush đo độ lớn âm thanh của trình phát và các ứng dụng khác để chỉ tạm dừng hoặc tắt tiếng những gì nghe được. Âm thanh không bao giờ bị ghi lại, lưu trữ hay gửi đi bất cứ đâu."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 會測量你的播放器和其他 App 的音量，只暫停或靜音確實聽得到的聲音。音訊絕不會被錄製、儲存或傳送到任何地方。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 会测量你的播放器和其他 App 的音量，只暂停或静音确实听得到的声音。音频绝不会被录制、存储或发送到任何地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 會測量你的播放器和其他 App 的音量，只暫停或靜音確實聽得到的聲音。音訊絕不會被錄製、儲存或傳送到任何地方。"
          }
        }
      }
    },
