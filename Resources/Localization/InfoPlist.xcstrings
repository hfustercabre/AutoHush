{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "Shown when macOS asks whether AutoHush may control the music player",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقف AutoHush مشغّل الموسيقى لديك مؤقتًا ثم يستأنفه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'AutoHush posa en pausa i reprèn el teu reproductor de música."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pausiert deinen Musikplayer und setzt die Wiedergabe fort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AutoHush pauses and resumes your music player."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pausa y reanuda tu reproductor de música."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pausa y reanuda tu reproductor de música."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush met votre lecteur de musique en pause et relance la lecture."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush met votre lecteur de musique en pause et relance la lecture."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush आपके म्यूज़िक प्लेयर को पॉज़ करता है और फिर से शुरू करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush menjeda dan melanjutkan pemutar musik Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mette in pausa e riprende il tuo lettore musicale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHushは音楽プレーヤーを一時停止して再開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush가 음악 플레이어를 일시 정지하고 다시 재생합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush pausa e retoma seu player de música."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush pausa e retoma o seu leitor de música."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ставит ваш музыкальный плеер на паузу и возобновляет воспроизведение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush müzik oynatıcınızı duraklatır ve sürdürür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush tạm dừng và tiếp tục trình phát nhạc của bạn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 會暫停並恢復你的音樂播放器。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 会暂停并恢复你的音乐播放器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 會暫停並恢復你的音樂播放器。"
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription" : {
      "comment" : "Shown when macOS asks whether AutoHush may record system audio",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقيس AutoHush ارتفاع صوت التطبيقات الأخرى، حتى لا يوقف موسيقاك مؤقتًا إلا عند وجود صوت مسموع. لا يُسجَّل الصوت أو يُخزَّن أو يُرسَل إلى أي مكان أبدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'AutoHush mesura el volum de les altres apps per posar la música en pausa només quan sonen de debò. L'àudio no es grava, no es desa ni s'envia enlloc."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush misst, wie laut andere Apps sind, damit deine Musik nur bei hörbarem Ton pausiert. Audio wird nie aufgenommen, gespeichert oder irgendwohin gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AutoHush measures how loud other apps are, so it only pauses your music for audible sound. Audio is never recorded, stored or sent anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mide el volumen de las demás apps para pausar tu música solo cuando suenan de verdad. El audio nunca se graba, se guarda ni se envía a ningún sitio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mide el volumen de las demás apps para pausar tu música solo cuando suenan de verdad. El audio nunca se graba, se guarda ni se envía a ninguna parte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mesure le volume des autres apps afin de ne mettre votre musique en pause que pour un son audible. L'audio n'est jamais enregistré, conservé ni envoyé où que ce soit."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mesure le volume des autres apps afin de ne mettre votre musique en pause que pour un son audible. L'audio n'est jamais enregistré, conservé ni envoyé où que ce soit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush मापता है कि दूसरे ऐप्स कितनी तेज़ आवाज़ में हैं, ताकि वह आपका संगीत सिर्फ़ सुनाई देने वाली आवाज़ पर ही पॉज़ करे। ऑडियो कभी रिकॉर्ड, संग्रहीत या कहीं भेजा नहीं जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mengukur seberapa keras app lain, sehingga hanya menjeda musik Anda saat ada suara yang terdengar. Audio tidak pernah direkam, disimpan, atau dikirim ke mana pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush misura il volume delle altre app per mettere in pausa la musica solo quando c'è un suono udibile. L'audio non viene mai registrato, salvato né inviato altrove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHushはほかのAppの音量を測定し、実際に音が聞こえるときだけ音楽を一時停止します。オーディオが録音、保存、送信されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush는 다른 앱의 소리 크기를 측정하여 실제로 소리가 들릴 때만 음악을 일시 정지합니다. 오디오는 녹음되거나 저장되거나 어디로도 전송되지 않습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush mede o volume dos outros apps para só pausar sua música quando há som audível. O áudio nunca é gravado, armazenado nem enviado a lugar algum."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush mede o volume das outras apps para só pausar a sua música quando há som audível. O áudio nunca é gravado, guardado nem enviado para lado nenhum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush измеряет громкость других приложений, чтобы ставить музыку на паузу только при слышимом звуке. Звук никогда не записывается, не сохраняется и никуда не отправляется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush, müziğinizi yalnızca duyulabilir bir ses olduğunda duraklatmak için diğer uygulamaların ses yüksekliğini ölçer. Ses hiçbir zaman kaydedilmez, saklanmaz veya bir yere gönderilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush đo độ lớn âm thanh của các ứng dụng khác để chỉ tạm dừng nhạc của bạn khi có âm thanh nghe được. Âm thanh không bao giờ bị ghi lại, lưu trữ hay gửi đi bất cứ đâu."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 會測量其他 App 的音量，只在確實聽得到聲音時才暫停你的音樂。音訊絕不會被錄製、儲存或傳送到任何地方。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 会测量其他 App 的音量，只在确实听得到声音时才暂停你的音乐。音频绝不会被录制、存储或发送到任何地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 會測量其他 App 的音量，只在確實聽得到聲音時才暫停你的音樂。音訊絕不會被錄製、儲存或傳送到任何地方。"
          }
        }
      }
    },
