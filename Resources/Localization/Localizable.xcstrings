    "Notifications are off for AutoHush, so it can't tell you about updates." : {
      "comment" : "Settings → Updates, under the update choices, while notifications are off for AutoHush",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإشعارات متوقفة لـ AutoHush، لذلك لا يستطيع إعلامك بالتحديثات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notificacions de l'AutoHush estan desactivades, així doncs no et pot avisar de les actualitzacions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznámení pro AutoHush jsou vypnutá, takže vás nemůže informovat o aktualizacích."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikationer er slået fra for AutoHush, så den kan ikke give dig besked om opdateringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen für AutoHush sind aus, daher kann es dich nicht über Updates informieren."
          }
        },
