          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала войдите, если %@ попросит. Реклама не считается: дождитесь того, что вы выбрали, затем нажмите «Играет»."
          }
        },
        "sk" : {
