    "About 3 minutes, with %@ muted and its window moving. You’re told more before it starts." : {
      "comment" : "Add an App window, under the step “AutoHush tries every way to pause and play it”; %@ is the app",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نحو 3 دقائق، مع كتم صوت %@ وتحريك نافذته. ستعرف المزيد قبل أن يبدأ."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uns 3 minuts, amb %@ en silenci i la finestra en moviment. Abans de començar, se t’explica més."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asi 3 minuty, během nichž je aplikace %@ ztlumená a její okno se přesouvá. Před začátkem se dozvíte víc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omkring 3 minutter, hvor %@ er lydløs, og vinduet flyttes. Du får mere at vide, før den begynder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa 3 Minuten, in denen %@ stummgeschaltet ist und das Fenster bewegt wird. Vor dem Start erfährst du mehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περίπου 3 λεπτά, με την εφαρμογή %@ σε σίγαση και το παράθυρό της να μετακινείται. Θα μάθετε περισσότερα πριν ξεκινήσει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos 3 minutos, con %@ en silencio y su ventana en movimiento. Antes de empezar, se te explica más."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos 3 minutos, con %@ en silencio y su ventana en movimiento. Antes de empezar, se te explica más."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noin 3 minuuttia, jolloin appi %@ on mykistetty ja sen ikkuna liikkuu. Saat lisätietoja ennen alkua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ 3 minutes, pendant lesquelles le son de %@ est coupé et sa fenêtre bouge. Vous en saurez plus avant le début."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ 3 minutes, pendant lesquelles le son de %@ est coupé et sa fenêtre bouge. Vous en saurez plus avant le début."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כ-3 דקות, כש-%@ מושתק והחלון שלו זז. פרטים נוספים יוצגו לפני ההתחלה."
          }
        },
        "hi" : {
