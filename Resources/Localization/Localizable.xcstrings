    "Once %@ shows in Safari (answer anything it asks first), click Add to Dock." : {
      "comment" : "Add a Web App window, under the step “Add it to the Dock”, above the Add to Dock button; %@ is the website, e.g. music.youtube.com",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد ظهور %@ في Safari (أجب أولًا عمّا يسأله)، انقر على «إضافة إلى شريط الأيقونات»."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan %@ es mostri al Safari (respon primer al que demani), fes clic a «Afegeix al Dock»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Až se %@ zobrazí v Safari (nejdřív odpovězte na případné dotazy), klikněte na „Přidat do Docku“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når %@ vises i Safari (svar først på eventuelle spørgsmål), skal du klikke på ”Føj til Dock”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald %@ in Safari angezeigt wird (beantworte vorher alle Fragen), klicke auf „Zum Dock hinzufügen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόλις εμφανιστεί ο %@ στο Safari (απαντήστε πρώτα σε ό,τι ρωτήσει), κάντε κλικ στο «Προσθήκη στο Dock»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando %@ se muestre en Safari (responde antes a lo que pregunte), haz clic en «Añadir al Dock»."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando %@ se muestre en Safari (responde antes a lo que pregunte), haz clic en «Agregar al Dock»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun %@ näkyy Safarissa (vastaa ensin sen kysymyksiin), osoita ”Lisää Dockiin”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dès que %@ s'affiche dans Safari (répondez d'abord à ses questions), cliquez sur « Ajouter au Dock »."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dès que %@ s'affiche dans Safari (répondez d'abord à ses questions), cliquez sur « Ajouter au Dock »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब Safari में %@ दिखे (पहले उसके सवालों का जवाब दें), तो “Dock में जोड़ें” पर क्लिक करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad se %@ prikaže u Safariju (prvo odgovorite na pitanja), kliknite „Dodaj u Dock”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amikor a(z) %@ megjelenik a Safariban (előbb válaszoljon a kérdéseire), kattintson a „Hozzáadás a Dockhoz” gombra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah %@ tampil di Safari (jawab dulu pertanyaannya), klik “Tambahkan ke Dock”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando %@ viene mostrato in Safari (rispondi prima a eventuali domande), fai clic su «Aggiungi al Dock»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safariに%@が表示されたら（先に質問に答えてから）、「Dockに追加」をクリックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari에 %@이(가) 표시되면(먼저 질문에 답한 다음) 'Dock에 추가'를 클릭하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når %@ vises i Safari (svar først på det den spør om), klikker du på «Legg til i Dock»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op ‘Voeg toe aan Dock’ zodra %@ in Safari verschijnt (beantwoord eerst eventuele vragen)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy %@ pojawi się w Safari (najpierw odpowiedz na pytania), kliknij „Dodaj do Docka”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando %@ aparecer no Safari (responda antes ao que for perguntado), clique em “Adicionar ao Dock”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando %@ for apresentado no Safari (responda primeiro ao que perguntar), clique em “Adicionar à Dock”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când %@ apare în Safari (răspundeți mai întâi la eventuale întrebări), faceți clic pe „Adăugați în Dock”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда %@ появится в Safari (сначала ответьте на вопросы), нажмите «Добавить в Dock»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď sa %@ zobrazí v Safari (najprv odpovedzte na prípadné otázky), kliknite na „Pridať do Docku“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko se %@ prikaže v Safariju (najprej odgovorite na vprašanja), kliknite »Dodaj v Dock«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När %@ visas i Safari (svara först på eventuella frågor) klickar du på ”Lägg till i Dock”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safari'de gösterildiğinde (önce sorduklarını yanıtlayın) “Dock'a ekle” düğmesine tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли %@ з’явиться в Safari (спершу дайте відповідь на запитання), натисніть «Додати в Dock»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi %@ hiển thị trong Safari (trả lời trước mọi câu hỏi), bấm “Thêm vào Dock”."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在 Safari 中顯示後（請先回答它的問題），按一下「加入 Dock」。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在 Safari 中显示后（请先回答它的问题），点按“添加到程序坞”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在 Safari 中顯示後（請先回答它的問題），按一下「加入 Dock」。"
          }
        }
      }
    },
