    "Reads %@’s menus and page, moves its window, and blocks the mouse and keyboard." : {
      "comment" : "Add an App window, under “Accessibility”: what the check uses it for; %@ is the app",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ قوائم %@ وصفحته، وينقل نافذته، ويحظر الماوس ولوحة المفاتيح."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llegeix els menús i la pàgina de %@, en mou la finestra i bloqueja el ratolí i el teclat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čte nabídky a stránku aplikace %@, přesouvá její okno a blokuje myš a klávesnici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læser menuerne og siden i %@, flytter vinduet og blokerer musen og tastaturet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest die Menüs und die Seite von %@, bewegt das Fenster und sperrt Maus und Tastatur."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαβάζει τα μενού και τη σελίδα της εφαρμογής %@, μετακινεί το παράθυρό της και αποκλείει το ποντίκι και το πληκτρολόγιο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee los menús y la página de %@, mueve su ventana y bloquea el ratón y el teclado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee los menús y la página de %@, mueve su ventana y bloquea el mouse y el teclado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukee apin %@ valikot ja sivun, siirtää sen ikkunaa ja estää hiiren ja näppäimistön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
