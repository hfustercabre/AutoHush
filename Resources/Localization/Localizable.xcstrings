    "Apps turned off don’t pause your player. Select apps to remove them." : {
      "comment" : "Settings → Sound Sources, under the list; “Select” as in clicking apps in the list (⌘-click or ⇧-click selects several)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التطبيقات التي أوقفتها لا توقف مشغّلك مؤقتًا. حدّد تطبيقات لإزالتها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps desactivades no posen en pausa el reproductor. Selecciona apps per eliminar-les."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnuté aplikace váš přehrávač nepozastavují. Vyberte aplikace, chcete-li je odstranit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps, der er slået fra, sætter ikke din afspiller på pause. Vælg apps for at fjerne dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgeschaltete Apps pausieren deinen Player nicht. Wähle Apps aus, um sie zu entfernen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι απενεργοποιημένες εφαρμογές δεν θέτουν σε παύση την εφαρμογή αναπαραγωγής σας. Επιλέξτε εφαρμογές για να τις αφαιρέσετε."
          }
        },
        "es" : {
