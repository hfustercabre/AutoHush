        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush가 위치한 폴더에 쓸 수 없으므로 스스로 업데이트할 수 없습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush não pode se atualizar sozinho porque não consegue gravar na pasta onde está."
          }
        },
        "pt-PT" : {
