    "Click Allow, then Allow again when macOS asks." : {
      "comment" : "Welcome window, under a permission macOS hasn't asked for yet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على «سماح»، ثم مرة أخرى عندما يسأل macOS."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes clic a Permet i després a Permet quan el macOS ho demani."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikněte na Povolit a pak znovu, až se macOS zeptá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik på Tillad og derefter igen, når macOS spørger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf „Erlauben“ und dann erneut, wenn macOS fragt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε κλικ στο «Να επιτρέπεται» και ξανά όταν ρωτήσει το macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en Permitir y otra vez en Permitir cuando macOS pregunte."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en Permitir y otra vez en Permitir cuando macOS pregunte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
