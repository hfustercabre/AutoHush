    "Hides the purple recording indicator. Detection is less precise." : {
      "comment" : "Settings, under AntiDot mode",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُخفي مؤشر التسجيل الأرجواني. الاكتشاف أقل دقة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amaga l'indicador lila de gravació. La detecció és menys precisa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skryje fialový indikátor nahrávání. Rozpoznávání je méně přesné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjuler den lilla optageindikator. Registreringen er mindre præcis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet die violette Aufnahmeanzeige aus. Die Erkennung ist ungenauer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποκρύπτει τη μοβ ένδειξη εγγραφής. Ο εντοπισμός είναι λιγότερο ακριβής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta el indicador morado de grabación. La detección es menos precisa."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta el indicador morado de grabación. La detección es menos precisa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piilottaa violetin tallennusilmaisimen. Tunnistus on epätarkempi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque l'indicateur d'enregistrement violet. La détection est moins précise."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque l'indicateur d'enregistrement violet. La détection est moins précise."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैंगनी रिकॉर्डिंग संकेतक छिपाता है। पहचान कम सटीक होती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriva ljubičasti indikator snimanja. Prepoznavanje je manje precizno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elrejti a lila felvételjelzőt. A felismerés kevésbé pontos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyembunyikan indikator rekaman ungu. Deteksi kurang presisi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde l'indicatore viola di registrazione. Il rilevamento è meno preciso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紫色の録音インジケータを表示しません。検出の精度は下がります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보라색 녹음 표시기를 숨깁니다. 감지 정확도가 낮아집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjuler den lilla opptaksindikatoren. Oppdagingen blir mindre presis."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbergt de paarse opname-indicator. De herkenning is minder nauwkeurig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukrywa fioletowy wskaźnik nagrywania. Wykrywanie jest mniej dokładne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta o indicador roxo de gravação. A detecção é menos precisa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta o indicador de gravação roxo. A deteção é menos precisa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascunde indicatorul violet de înregistrare. Detectarea este mai puțin precisă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывает фиолетовый индикатор записи. Определение менее точное."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skryje fialový indikátor nahrávania. Rozpoznávanie je menej presné."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrije vijoličasti indikator snemanja. Zaznavanje je manj natančno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Döljer den lila inspelningsindikatorn. Upptäckten blir mindre exakt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mor kayıt göstergesini gizler. Algılama daha az kesindir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приховує фіолетовий індикатор записування. Визначення менш точне."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẩn chỉ báo ghi màu tím. Phát hiện kém chính xác hơn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱藏紫色錄音指示器。偵測較不精確。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
