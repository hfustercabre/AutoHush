        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute app dont l'audio est ouvert compte comme en lecture, même en pause."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिस भी ऐप का ऑडियो खुला है, वह चलता हुआ माना जाता है, पॉज़ होने पर भी।"
