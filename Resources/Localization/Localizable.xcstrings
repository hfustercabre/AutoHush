    "Once %@ shows in Safari (answer anything it asks first), click Add to Dock." : {
      "comment" : "Add a Web App window, under the step “Add it to the Dock”, above the Add to Dock button; %@ is the website, e.g. music.youtube.com",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد ظهور %@ في Safari (أجب أولًا عمّا يسأله)، انقر على «إضافة إلى شريط الأيقونات»."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan %@ es mostri al Safari (respon primer al que demani), fes clic a «Afegeix al Dock»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Až se %@ zobrazí v Safari (nejdřív odpovězte na případné dotazy), klikněte na „Přidat do Docku“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når %@ vises i Safari (svar først på eventuelle spørgsmål), skal du klikke på ”Føj til Dock”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald %@ in Safari angezeigt wird (beantworte vorher alle Fragen), klicke auf „Zum Dock hinzufügen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόλις εμφανιστεί ο %@ στο Safari (απαντήστε πρώτα σε ό,τι ρωτήσει), κάντε κλικ στο «Προσθήκη στο Dock»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando %@ se muestre en Safari (responde antes a lo que pregunte), haz clic en «Añadir al Dock»."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando %@ se muestre en Safari (responde antes a lo que pregunte), haz clic en «Agregar al Dock»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun %@ näkyy Safarissa (vastaa ensin sen kysymyksiin), osoita ”Lisää Dockiin”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dès que %@ s’affiche dans Safari (répondez d’abord à ses questions), cliquez sur « Ajouter au Dock »."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dès que %@ s’affiche dans Safari (répondez d’abord à ses questions), cliquez sur « Ajouter au Dock »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
