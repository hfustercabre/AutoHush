    "Your player doesn’t resume after a call that came while it was paused." : {
      "comment" : "Settings → Calls, under “Stay paused after calls”; a call is an app using the microphone",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُستأنف مشغّلك بعد مكالمة وصلت أثناء الإيقاف المؤقت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reproductor no es reprèn després d’una trucada arribada mentre estava en pausa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš přehrávač se neobnoví po hovoru, který přišel během pauzy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din afspiller genoptages ikke efter et opkald, der kom, mens den var sat på pause."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Player wird nach einem Anruf, der während der Pause kam, nicht fortgesetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εφαρμογή αναπαραγωγής σας δεν συνεχίζει μετά από κλήση που ήρθε ενώ ήταν σε παύση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu reproductor no se reanuda tras una llamada que llegó mientras estaba en pausa."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu reproductor no se reanuda tras una llamada que llegó mientras estaba en pausa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soittimesi ei jatka puhelun jälkeen, joka tuli tauon aikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre lecteur ne reprend pas après un appel arrivé pendant la pause."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre lecteur ne reprend pas après un appel arrivé pendant la pause."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הנגן שלך לא חוזר לנגן אחרי שיחה שהגיעה בזמן שהיה מושהה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पॉज़ के दौरान आए कॉल के बाद आपका प्लेयर फिर से शुरू नहीं होता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš se reproduktor ne nastavlja nakon poziva koji je stigao tijekom pauze."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lejátszója nem folytatódik a szünet alatt érkezett hívás után."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemutar Anda tidak dilanjutkan setelah panggilan yang masuk saat dijeda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il lettore non riprende dopo una chiamata arrivata mentre era in pausa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止中にあった通話の後は、プレーヤーは再開されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 정지 중에 온 통화 이후에는 플레이어가 재개되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemain anda tidak disambung semula selepas panggilan yang tiba semasa ia dijeda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spilleren din fortsetter ikke etter en samtale som kom mens den var satt på pause."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je speler wordt niet hervat na een gesprek dat tijdens de pauze binnenkwam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój odtwarzacz nie wznawia się po połączeniu, które przyszło podczas pauzy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu player não retoma após uma chamada que chegou enquanto estava pausado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu leitor não retoma após uma chamada que chegou enquanto estava em pausa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playerul dvs. nu se reia după un apel venit cât timp era în pauză."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш плеер не возобновляется после звонка, пришедшего во время паузы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš prehrávač sa neobnoví po hovore, ktorý prišiel počas pauzy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš predvajalnik se ne nadaljuje po klicu, ki je prišel med premorom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din spelare återupptas inte efter ett samtal som kom medan den var pausad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวเล่นของคุณจะไม่เล่นต่อหลังการโทรที่เข้ามาขณะหยุดพักอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duraklatılmışken gelen bir aramadan sonra oynatıcınız sürdürülmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш програвач не відновлюється після дзвінка, що надійшов під час паузи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình phát của bạn không tiếp tục sau cuộc gọi đến khi đang tạm dừng."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果暫停期間有來電，你的播放器在通話後不會恢復播放。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果暂停期间有来电，你的播放器在通话后不会恢复播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果暫停期間有來電，你的播放器在通話後不會恢復播放。"
          }
        }
      }
    },
    "You’ll choose another player. The app stays on your Mac, and Add an App… can add it back." : {
      "comment" : "Message of the alert before the media player (an app added with Add an App) is removed",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستختار مشغّلاً آخر. يبقى التطبيق على جهاز Mac، ويمكن لـ «إضافة تطبيق…» إضافته من جديد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’hauràs de triar un altre reproductor. L’app es queda al Mac, i Afegeix una app… la pot tornar a afegir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberete jiný přehrávač. Aplikace zůstane na Macu a Přidat aplikaci… ji může přidat znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vælger en anden afspiller. Appen bliver på din Mac, og Tilføj en app… kan tilføje den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wählst einen anderen Player. Die App bleibt auf deinem Mac, und „App hinzufügen …“ kann sie wieder hinzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα επιλέξετε άλλη εφαρμογή αναπαραγωγής. Η εφαρμογή μένει στο Mac σας και η Προσθήκη εφαρμογής… μπορεί να την προσθέσει ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegirás otro reproductor. La app sigue en tu Mac, y Añadir una app… puede volver a añadirla."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegirás otro reproductor. La app sigue en tu Mac, y Agregar una app… puede volver a agregarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitset toisen soittimen. Appi jää Maciin, ja Lisää appi… voi lisätä sen takaisin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous choisirez un autre lecteur. L’app reste sur votre Mac, et Ajouter une app… peut l’ajouter de nouveau."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous choisirez un autre lecteur. L’app reste sur votre Mac, et Ajouter une app… peut l’ajouter de nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יהיה צורך לבחור נגן אחר. האפליקציה נשארת ב-Mac שלך, ו“הוספת אפליקציה…” יכולה להוסיף אותה בחזרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप दूसरा प्लेयर चुनेंगे। ऐप आपके Mac पर रहता है, और ऐप जोड़ें… इसे फिर से जोड़ सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odabrat ćete drugi reproduktor. Aplikacija ostaje na Macu, a Dodaj aplikaciju… može je ponovno dodati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Másik lejátszót választ. Az app a Macen marad, és az App hozzáadása… újra hozzáadhatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda akan memilih pemutar lain. App tetap ada di Mac Anda, dan Tambahkan App… dapat menambahkannya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sceglierai un altro lettore. L’app resta sul Mac, e Aggiungi un’app… può aggiungerla di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のプレーヤーを選ぶことになります。Appはこのまま残り、「Appを追加…」でもう一度追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 플레이어를 선택하게 됩니다. 앱은 Mac에 그대로 남으며, 앱 추가…로 다시 추가할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda akan memilih pemain lain. App kekal pada Mac anda, dan Tambah App… boleh menambahnya semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du velger en annen spiller. Appen blir værende på Macen, og Legg til en app… kan legge den til igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kiest een andere speler. De app blijft op je Mac, en met ‘Voeg een app toe…’ voeg je hem weer toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierzesz inny odtwarzacz. Aplikacja pozostanie na Macu, a Dodaj aplikację… może ją dodać ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você escolherá outro player. O app continua no seu Mac, e Adicionar um App… pode adicioná-lo de volta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irá escolher outro leitor. A app continua no seu Mac, e Adicionar uma app… pode voltar a adicioná-la."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
