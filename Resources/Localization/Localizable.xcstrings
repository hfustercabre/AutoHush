        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोक दिया गया। सब कुछ पहले जैसा कर दिया गया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaustavljeno. Sve je vraćeno kako je bilo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leállítva. Minden visszaállt az eredeti állapotába."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
