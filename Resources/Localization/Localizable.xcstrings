          }
        }
      }
    },
    "AutoHush pauses it while other apps play audio, and resumes it afterwards. You can change it at any time in the menu or in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقفه AutoHush مؤقتًا بينما تُشغّل التطبيقات الأخرى الصوت، ثم يستأنفه بعد ذلك. يمكنك تغييره في أي وقت من القائمة أو من الإعدادات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'AutoHush el posa en pausa mentre altres apps reprodueixen àudio i el reprèn després. El pots canviar quan vulguis des del menú o a la configuració."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pausiert ihn, während andere Apps Audio abspielen, und setzt die Wiedergabe danach fort. Du kannst ihn jederzeit im Menü oder in den Einstellungen ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush lo pausa mientras otras apps reproducen audio y lo reanuda después. Puedes cambiarlo cuando quieras desde el menú o en Ajustes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush lo pausa mientras otras apps reproducen audio y lo reanuda después. Puedes cambiarlo cuando quieras desde el menú o en Configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush le met en pause pendant que d'autres apps lisent du son, puis le relance. Vous pouvez le changer à tout moment dans le menu ou dans les Réglages."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush le met en pause pendant que d'autres apps lisent du son, puis le relance. Vous pouvez le changer à tout moment dans le menu ou dans les Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब दूसरे ऐप्स ऑडियो चलाते हैं, तो AutoHush इसे पॉज़ करता है और बाद में फिर से शुरू करता है। आप इसे कभी भी मेनू या सेटिंग में बदल सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush menjedanya saat app lain memutar audio, lalu melanjutkannya setelahnya. Anda dapat mengubahnya kapan saja di menu atau di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush lo mette in pausa mentre altre app riproducono audio e poi lo riprende. Puoi cambiarlo in qualsiasi momento dal menu o nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのAppがオーディオを再生している間は一時停止し、終わると再開します。メニューまたは設定でいつでも変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱이 오디오를 재생하는 동안 일시 정지하고, 끝나면 다시 재생합니다. 메뉴나 설정에서 언제든지 변경할 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush o pausa enquanto outros apps reproduzem áudio e o retoma depois. Você pode alterá-lo a qualquer momento no menu ou nos Ajustes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush coloca-o em pausa enquanto outras apps reproduzem áudio e retoma-o depois. Pode alterá-lo a qualquer momento no menu ou nas Definições."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ставит его на паузу, пока другие приложения воспроизводят звук, и затем возобновляет. Его можно сменить в любое время в меню или в настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer uygulamalar ses çalarken AutoHush müzik oynatıcınızı duraklatır ve ardından sürdürür. Bunu istediğiniz zaman menüden veya Ayarlar’dan değiştirebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush tạm dừng trình phát khi các ứng dụng khác phát âm thanh và tiếp tục phát sau đó. Bạn có thể thay đổi bất cứ lúc nào trong menu hoặc trong Cài đặt."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在其他 App 播放音訊時，AutoHush 會將其暫停，並在之後繼續播放。你可以隨時在選單或設定中更改。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在其他 App 播放音频时，AutoHush 会将其暂停，并在之后继续播放。你可以随时在菜单或设置中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在其他 App 播放音訊時，AutoHush 會將其暫停，並在之後繼續播放。你可以隨時在選單或設定中更改。"
          }
        }
      }
    },
