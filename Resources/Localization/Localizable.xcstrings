    "Apps appear here once they have played audio." : {
      "comment" : "Settings → Sound Sources, while the list is empty",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر التطبيقات هنا بعد أن تُشغّل الصوت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps apareixen aquí quan han reproduït àudio."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace se tu zobrazí, jakmile přehrají zvuk."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps vises her, når de har afspillet lyd."
