          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualsiasi app con l'audio aperto conta come in riproduzione, anche se in pausa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオが開いているAppは、一時停止中でも再生中として扱われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
