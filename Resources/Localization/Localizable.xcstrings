    "Pauses what's playing (music, podcasts or videos) while other apps play audio, and resumes it afterwards." : {
      "comment" : "Settings → About: what AutoHush does",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقف ما يُشغَّل مؤقتًا (موسيقى أو بودكاست أو فيديو) بينما تُشغّل التطبيقات الأخرى الصوت، ثم يستأنفه بعد ذلك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posa en pausa el que sona (música, pòdcasts o vídeos) mentre altres apps reprodueixen àudio, i ho reprèn després."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozastavuje to, co hraje (hudbu, podcasty nebo videa), když jiné aplikace přehrávají zvuk, a potom to obnoví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sætter det, der afspilles (musik, podcasts eller videoer), på pause, mens andre apps afspiller lyd, og genoptager det bagefter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert, was gerade läuft (Musik, Podcasts oder Videos), während andere Apps Audio abspielen, und setzt es danach fort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θέτει σε παύση ό,τι παίζει (μουσική, podcast ή βίντεο) όσο άλλες εφαρμογές αναπαράγουν ήχο και το συνεχίζει μετά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa lo que suena (música, pódcasts o vídeos) mientras otras apps reproducen audio, y lo reanuda después."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
