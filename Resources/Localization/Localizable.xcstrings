          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι γνωστοποιήσεις για το AutoHush είναι απενεργοποιημένες, οπότε δεν μπορεί να σας ενημερώνει για ενημερώσεις."
          }
        },
        "es" : {
          "stringUnit" : {
