        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %@, um zu pausieren und auf „Ist pausiert“ zu klicken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
