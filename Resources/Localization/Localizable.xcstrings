    "%@ is the only supported media player on this Mac. AutoHush also works with %@." : {
      "comment" : "Welcome window; the installed media player, then the other supported ones, e.g. “Apple Music and VLC”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ هو مشغّل الوسائط الوحيد المدعوم على جهاز Mac هذا. يعمل AutoHush أيضًا مع %2$@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ és l'únic reproductor multimèdia compatible d'aquest Mac. L'AutoHush també funciona amb %2$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ je jediný podporovaný přehrávač médií na tomto Macu. AutoHush funguje také s těmito: %2$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ er den eneste understøttede medieafspiller på denne Mac. AutoHush virker også med %2$@."
