          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liitä sivusto, joka toistaa musiikkia, podcasteja tai videoita. AutoHush lisää sen Dockiin appina ja opettelee sen säätimet."
          }
        },
        "fr" : {
          "stringUnit" : {
