        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ne peut pas se mettre à jour, car il ne peut pas écrire dans son dossier."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ne peut pas se mettre à jour, car il ne peut pas écrire dans son dossier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
