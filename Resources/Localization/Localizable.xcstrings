    "Quieter output counts as silence. Only used while measuring audio levels (AntiDot mode off)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعدّ الخرج الأخفض صمتًا. يُستخدم فقط أثناء قياس مستويات الصوت (وضع AntiDot متوقف)."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un so més fluix compta com a silenci. Només s'utilitza en mesurar els nivells d'àudio (mode AntiDot desactivat)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leiseres Audio zählt als Stille. Wird nur beim Messen der Audiopegel verwendet (AntiDot-Modus aus)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sonido más bajo cuenta como silencio. Solo se usa al medir los niveles de audio (modo AntiDot desactivado)."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sonido más bajo cuenta como silencio. Solo se usa al medir los niveles de audio (modo AntiDot desactivado)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un son plus faible compte comme du silence. Utilisé uniquement lors de la mesure des niveaux audio (mode AntiDot désactivé)."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un son plus faible compte comme du silence. Utilisé uniquement lors de la mesure des niveaux audio (mode AntiDot désactivé)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे धीमा आउटपुट शांति माना जाता है। सिर्फ़ ऑडियो स्तर मापते समय इस्तेमाल होता है (AntiDot मोड बंद)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Output yang lebih pelan dianggap senyap. Hanya digunakan saat mengukur level audio (mode AntiDot mati)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un audio più basso conta come silenzio. Usata solo durante la misurazione dei livelli audio (modalità AntiDot disattivata)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これより小さい音は無音として扱われます。オーディオレベルを測定する場合（AntiDotモードがオフのとき）にのみ使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이보다 작은 소리는 무음으로 간주됩니다. 오디오 레벨을 측정할 때만(AntiDot 모드 끔) 사용됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áudio mais baixo conta como silêncio. Usado apenas ao medir os níveis de áudio (modo AntiDot desativado)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um som mais baixo conta como silêncio. Só é usado ao medir os níveis de áudio (modo AntiDot desativado)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более тихий звук считается тишиной. Используется только при измерении уровней звука (режим AntiDot выключен)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha sessiz çıkış sessizlik sayılır. Yalnızca ses düzeyleri ölçülürken kullanılır (AntiDot modu kapalı)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âm thanh nhỏ hơn được coi là im lặng. Chỉ dùng khi đo mức âm thanh (chế độ AntiDot tắt)."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比此更小的聲音會視為無聲。僅在測量音訊音量時使用（AntiDot 模式關閉）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比此更小的声音会视为无声。仅在测量音频电平时使用（AntiDot 模式关闭）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比此更小的聲音會視為無聲。僅在測量音訊音量時使用（AntiDot 模式關閉）。"
          }
        }
      }
    },
