        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush installerer oppdateringen når den ikke holder spilleren din på pause, og gir deg beskjed etterpå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush installeert de update wanneer het je speler niet gepauzeerd houdt, en laat het je achteraf weten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush instaluje uaktualnienie, gdy nie wstrzymuje Twojego odtwarzacza, a potem o tym informuje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush instala a atualização quando não está mantendo seu player em pausa e avisa você depois."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush instala-a quando não tem o seu leitor em pausa e avisa-o depois."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush instalează actualizarea când nu ține playerul dvs. pe pauză și vă anunță după aceea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush установит обновление, когда не держит ваш плеер на паузе, и сообщит вам об этом."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush aktualizáciu nainštaluje, keď nedrží váš prehrávač pozastavený, a potom vám dá vedieť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush namesti posodobitev, ko vašega predvajalnika ne drži zaustavljenega, in vas nato obvesti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush installerar uppdateringen när den inte håller din spelare pausad och meddelar dig efteråt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush güncellemeyi oynatıcınızı duraklatılmış tutmadığı bir anda yükler ve ardından size haber verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush встановлює оновлення, коли не тримає ваш програвач на паузі, і потім повідомляє вас."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush cài đặt bản cập nhật khi không giữ trình phát của bạn tạm dừng, và báo cho bạn sau đó."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 會在沒有暫停你的播放器時安裝更新項目，並在之後通知你。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 会在没有暂停你的播放器时安装更新，并在之后通知你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 會在沒有暫停你的播放器時安裝更新項目，並在之後通知你。"
          }
        }
      }
    },
    "AutoHush lets you know. Install the update from its menu whenever you like." : {
      "comment" : "Settings, under the update choice Notify me",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعلمك AutoHush. ثبّت التحديث من قائمته متى شئت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'AutoHush t'avisa. Instal·la l'actualització des del seu menú quan vulguis."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush vám dá vědět. Aktualizaci nainstalujte z jeho nabídky, kdykoli budete chtít."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush giver dig besked. Installer opdateringen fra dens menu, når du vil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush sagt dir Bescheid. Installiere das Update über sein Menü, wann immer du willst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το AutoHush σας ειδοποιεί. Εγκαταστήστε την ενημέρωση από το μενού του όποτε θέλετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush te avisa. Instala la actualización desde su menú cuando quieras."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush te avisa. Instala la actualización desde su menú cuando quieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush kertoo sinulle. Asenna päivitys sen valikosta milloin haluat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush vous prévient. Installez la mise à jour depuis son menu quand vous le souhaitez."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush vous prévient. Installez la mise à jour depuis son menu quand vous le souhaitez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush आपको बताता है। जब चाहें, इसके मेनू से अपडेट इंस्टॉल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush vas obavještava. Instalirajte ažuriranje iz njegova izbornika kad god želite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az AutoHush értesíti Önt. A frissítést bármikor telepítheti a menüjéből."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush memberi tahu Anda. Instal pembaruan dari menunya kapan pun Anda mau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ti avvisa. Installa l'aggiornamento dal suo menu quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHushがお知らせします。アップデートはいつでもメニューからインストールできます。"
