            "value" : "أي تطبيق صوته مفتوح يُعدّ قيد التشغيل، حتى عند إيقافه مؤقتًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualsevol app amb l'àudio obert compta com a reproduint, encara que estigui en pausa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede App mit offenem Audio zählt als wiedergebend, auch wenn sie pausiert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier app con el audio abierto cuenta como en reproducción, aunque esté en pausa."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
