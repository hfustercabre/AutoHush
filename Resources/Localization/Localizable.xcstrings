    "The most the Mac’s volume goes down as your player resumes." : {
      "comment" : "Settings → Advanced, under “Lower by at most”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أقصى ما ينخفض إليه مستوى صوت Mac عند استئناف مشغّلك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El màxim que baixa el volum del Mac quan el reproductor es reprèn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejvíc, o kolik se sníží hlasitost Macu, když se váš přehrávač obnoví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det mest, Mac’ens lydstyrke sænkes, når din afspiller genoptages."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So weit wird die Mac-Lautstärke höchstens verringert, wenn dein Player fortgesetzt wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το μέγιστο που χαμηλώνει η ένταση του Mac όταν συνεχίζει η εφαρμογή αναπαραγωγής σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo máximo que baja el volumen del Mac cuando tu reproductor se reanuda."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
