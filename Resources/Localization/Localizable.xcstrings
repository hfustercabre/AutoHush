            "value" : "Vyžaduje nahrávání zvuku, které režim AntiDot nepoužívá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den kræver lydoptagelse, som AntiDot-tilstand ikke bruger."
          }
        },
        "de" : {
