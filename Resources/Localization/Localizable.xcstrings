        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps erscheinen hier, sobald sie Audio abgespielt haben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εφαρμογές εμφανίζονται εδώ μόλις αναπαράγουν ήχο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps aparecen aquí cuando han reproducido audio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps aparecen aquí cuando han reproducido audio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apit näkyvät täällä, kun ne ovat toistaneet ääntä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
