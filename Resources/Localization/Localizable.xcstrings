    "AutoHush downloads it and lets you know. It keeps the download for 7 days." : {
      "comment" : "Settings, under the update choice Download it and notify me",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'AutoHush la baixa i t'avisa. Conserva la baixada durant 7 dies."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush lädt es und sagt dir Bescheid. Der Download wird 7 Tage lang aufbewahrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush la descarga y te avisa. Guarda la descarga durante 7 días."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush la descarga y te avisa. Guarda la descarga durante 7 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush la télécharge et vous prévient. Le téléchargement est conservé 7 jours."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush la télécharge et vous prévient. Le téléchargement est conservé 7 jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush lo scarica e ti avvisa. Conserva il download per 7 giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHushがダウンロードしてお知らせします。ダウンロードは7日間保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush가 다운로드하고 알려 드립니다. 다운로드한 파일은 7일 동안 보관됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush baixa a atualização e avisa você. O download fica guardado por 7 dias."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush descarrega-a e avisa-o. A transferência é guardada durante 7 dias."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 会下载更新并通知你。下载的文件保留 7 天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
