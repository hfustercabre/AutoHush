    "Clicks, scrolling and keys are blocked until it ends. Escape or Stop ends the check." : {
      "comment" : "The check's panel, while the check blocks the mouse and keyboard",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحظر النقرات والتمرير والمفاتيح حتى ينتهي. يُنهي مفتاح Esc أو زر «إيقاف» الفحص."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els clics, el desplaçament i les tecles estan bloquejats fins que acabi. Esc o «Atura» acaba la comprovació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutí, posouvání a klávesy jsou až do konce kontroly zablokované. Kontrolu ukončíte klávesou Esc nebo tlačítkem „Zastavit“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik, rulning og taster er blokeret, indtil den er færdig. Esc eller ”Stop” afslutter kontrollen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicks, Scrollen und Tasten sind bis zum Ende gesperrt. Esc oder „Stoppen“ beendet die Prüfung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κλικ, η κύλιση και τα πλήκτρα αποκλείονται μέχρι να τελειώσει. Το Escape ή η «Διακοπή» τερματίζει τον έλεγχο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los clics, el desplazamiento y las teclas están bloqueados hasta que termine. Esc o «Detener» termina la comprobación."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los clics, el desplazamiento y las teclas están bloqueados hasta que termine. Esc o «Detener» termina la verificación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikkaukset, vieritys ja näppäimet on estetty tarkistuksen ajan. Esc tai ”Pysäytä” lopettaa tarkistuksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clics, le défilement et les touches sont bloqués jusqu’à la fin. Échap ou « Arrêter » met fin à la vérification."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clics, le défilement et les touches sont bloqués jusqu’à la fin. Échap ou « Arrêter » met fin à la vérification."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחיצות, גלילה ומקשים חסומים עד לסיום. Esc או “עצירה” מסיימים את הבדיקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ख़त्म होने तक क्लिक, स्क्रॉल और कुंजियाँ ब्लॉक रहती हैं। Escape या “रोकें” जाँच ख़त्म करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikovi, pomicanje i tipke blokirani su do kraja. Escape ili „Zaustavi” završava provjeru."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
