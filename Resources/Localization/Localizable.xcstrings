        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमति दें पर क्लिक करें, फिर macOS के पूछने पर दोबारा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
