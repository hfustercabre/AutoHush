          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer app com o áudio aberto conta como a tocar, mesmo em pausa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любое приложение с открытым аудиовыходом считается играющим, даже на паузе."
          }
        },
        "tr" : {
          "stringUnit" : {
