    "%@ was added, but AutoHush can’t find it yet. Click Continue to try again." : {
      "comment" : "Add a Web App window, when the web app was made but macOS doesn't list it yet; %@ is the web app's name; Continue is the window's button",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت إضافة %@، لكن AutoHush لا يعثر عليه بعد. انقر على «متابعة» للمحاولة مرة أخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’ha afegit %@, però l’AutoHush encara no la troba. Fes clic a «Continua» per tornar-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace %@ byla přidána, ale AutoHush ji zatím nemůže najít. Klikněte na „Pokračovat“ a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ blev tilføjet, men AutoHush kan ikke finde den endnu. Klik på ”Fortsæt” for at prøve igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde hinzugefügt, aber AutoHush findet die App noch nicht. Klicke auf „Fortfahren“, um es erneut zu versuchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εφαρμογή %@ προστέθηκε, αλλά το AutoHush δεν τη βρίσκει ακόμα. Κάντε κλικ στο «Συνέχεια» για να προσπαθήσετε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se ha añadido, pero AutoHush aún no la encuentra. Haz clic en «Continuar» para volver a intentarlo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se agregó, pero AutoHush aún no la encuentra. Haz clic en «Continuar» para volver a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lisättiin, mutta AutoHush ei vielä löydä sitä. Yritä uudelleen osoittamalla ”Jatka”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a été ajoutée, mais AutoHush ne la trouve pas encore. Cliquez sur « Continuer » pour réessayer."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a été ajoutée, mais AutoHush ne la trouve pas encore. Cliquez sur « Continuer » pour réessayer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ נוסף, אבל AutoHush עדיין לא מוצא אותו. יש ללחוץ על “המשך” כדי לנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ जोड़ दिया गया, लेकिन AutoHush उसे अभी ढूँढ नहीं पा रहा। फिर से कोशिश करने के लिए “जारी रखें” पर क्लिक करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija %@ je dodana, ali je AutoHush još ne može pronaći. Kliknite „Nastavi” da biste pokušali ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ hozzáadva, de az AutoHush még nem találja. Kattintson a „Folytatás” gombra az újrapróbálkozáshoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
