        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naučeno. Pokud se AutoHush mýlí, naučte ho znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lært. Lær den igen, hvis AutoHush tager fejl."
          }
        },
        "de" : {
