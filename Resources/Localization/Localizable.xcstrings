    "Not reopened: its page may not take presses while it’s covered or on another desktop" : {
      "comment" : "Add an App window, under the step “Reopen %@” once skipped",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعَد فتحه: قد لا تستجيب صفحته للضغط بينما نافذته مغطاة أو على سطح مكتب آخر"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha tornat a obrir: pot ser que els botons de la pàgina no responguin amb la finestra tapada o en un altre escriptori"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znovu neotevřeno: její stránka nemusí reagovat na stisknutí, když je zakrytá nebo na jiné ploše"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke åbnet igen: dens side reagerer måske ikke på tryk, mens vinduet er dækket eller på et andet skrivebord"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht erneut geöffnet: Die Seite reagiert vielleicht nicht, während das Fenster verdeckt oder auf einem anderen Schreibtisch ist"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν άνοιξε ξανά: η σελίδα της ίσως δεν δέχεται πατήματα όταν το παράθυρο είναι καλυμμένο ή σε άλλο γραφείο εργασίας"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha vuelto a abrir: puede que los botones de su página no respondan con la ventana tapada o en otro escritorio"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se volvió a abrir: puede que los botones de su página no respondan con la ventana cubierta o en otro escritorio"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei avattu uudelleen: sen sivu ei ehkä reagoi painalluksiin, kun se on peitetty tai toisella työpöydällä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non rouverte : sa page peut ne pas réagir quand sa fenêtre est recouverte ou sur un autre bureau"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non rouverte : sa page peut ne pas réagir quand sa fenêtre est recouverte ou sur un autre bureau"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא נפתחה מחדש: ייתכן שהדף שלה לא יקבל לחיצות כשהוא מכוסה או בשולחן עבודה אחר"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फिर से नहीं खोला गया: हो सकता है इसके ढके होने या किसी दूसरे डेस्कटॉप पर होने पर इसका पेज दबाने पर प्रतिक्रिया न दे"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije ponovno otvorena: njezina stranica možda ne prima pritiske dok je prozor prekriven ili na drugoj radnoj površini"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
