        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен сайт працює по-своєму, тож вебпрограма може призупинятися або відновлюватися не так, як очікується."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi trang web hoạt động theo cách riêng, vì vậy ứng dụng web có thể không tạm dừng hoặc tiếp tục như mong đợi."
          }
        },
        "zh-HK" : {
