    "Stop here, Stop in the panel or Escape ends the check." : {
      "comment" : "Add an App window, under the check's step while it runs (a Stop button follows; the panel is the check's, at the bottom right of the screen)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنهي زر «إيقاف» هنا أو في اللوحة، أو مفتاح Esc، الفحص."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Atura» aquí o al tauler, o Esc, acaba la comprovació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrolu ukončíte tlačítkem „Zastavit“ zde nebo v panelu, nebo klávesou Esc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Stop” her eller i panelet eller Esc afslutter kontrollen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Stoppen“ hier oder im Fortschrittsfenster oder Esc beendet die Prüfung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η «Διακοπή» εδώ ή στο πλαίσιο, ή το Escape, τερματίζει τον έλεγχο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Detener» aquí o en el panel, o Esc, termina la comprobación."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Detener» aquí o en el panel, o Esc, termina la verificación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Pysäytä” täällä tai paneelissa tai Esc lopettaa tarkistuksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Arrêter » ici ou dans le panneau, ou Échap, met fin à la vérification."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Arrêter » ici ou dans le panneau, ou Échap, met fin à la vérification."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“עצירה” כאן או בחלונית, או Esc, מסיימים את הבדיקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ या पैनल में “रोकें”, या Escape, जाँच ख़त्म करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zaustavi” ovdje ili na ploči, ili Escape, završava provjeru."
          }
        },
        "hu" : {
          "stringUnit" : {
