          }
        }
      }
    },
    "AutoHush lets you know. Install the update from its menu whenever you like." : {
      "comment" : "Settings, under the update choice Notify me",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
