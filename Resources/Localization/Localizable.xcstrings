        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ δεν ταυτοποιείται όπως οι εφαρμογές Mac, οπότε το AutoHush δεν μπορεί να καταλάβει πότε αναπαράγει ήχο."
          }
        },
        "es" : {
