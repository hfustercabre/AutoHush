    "AutoHush: couldn't pause your player" : {
      "comment" : "VoiceOver label of the menu bar icon",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush: تعذّر إيقاف مشغّلك مؤقتًا"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush: no s'ha pogut posar en pausa el reproductor"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush: přehrávač nelze pozastavit"
          }
        },
        "da" : {
