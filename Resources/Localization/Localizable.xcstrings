    "AutoHush can't update itself, because it can't write to the folder it's in." : {
      "comment" : "Settings, under the update choices",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع AutoHush تحديث نفسه لأنه لا يستطيع الكتابة في المجلد الموجود فيه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'AutoHush no es pot actualitzar sol, perquè no pot escriure a la carpeta on és."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush se nemůže aktualizovat, protože nemůže zapisovat do složky, ve které je."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush kan ikke opdatere sig selv, fordi den ikke kan skrive til den mappe, den ligger i."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush kann sich nicht selbst aktualisieren, weil es nicht in seinen Ordner schreiben kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το AutoHush δεν μπορεί να ενημερωθεί, επειδή δεν μπορεί να γράψει στον φάκελο όπου βρίσκεται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush no puede actualizarse solo porque no puede escribir en la carpeta donde está."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush no puede actualizarse solo porque no puede escribir en la carpeta donde está."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ei voi päivittää itseään, koska se ei voi kirjoittaa kansioon, jossa se on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ne peut pas se mettre à jour, car il ne peut pas écrire dans son dossier."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ne peut pas se mettre à jour, car il ne peut pas écrire dans son dossier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ख़ुद को अपडेट नहीं कर सकता, क्योंकि वह जिस फ़ोल्डर में है उसमें लिख नहीं सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush se ne može ažurirati jer ne može pisati u mapu u kojoj se nalazi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az AutoHush nem tudja frissíteni magát, mert nem tud írni abba a mappába, amelyben van."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush tidak dapat memperbarui dirinya karena tidak dapat menulis ke foldernya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush non può aggiornarsi da solo perché non può scrivere nella cartella in cui si trova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHushは、保存されているフォルダに書き込めないため、自動的にアップデートできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush가 위치한 폴더에 쓸 수 없으므로 스스로 업데이트할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush kan ikke oppdatere seg selv, fordi den ikke kan skrive til mappen den ligger i."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush kan zichzelf niet bijwerken, omdat het niet kan schrijven in de map waarin het staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush nie może się uaktualnić, bo nie może zapisywać w folderze, w którym się znajduje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush não pode se atualizar sozinho porque não consegue gravar na pasta onde está."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush não se pode atualizar sozinho porque não consegue escrever na pasta onde está."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush nu se poate actualiza, deoarece nu poate scrie în dosarul în care se află."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush не может обновиться, так как не может записывать в свою папку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush sa nemôže aktualizovať, pretože nemôže zapisovať do priečinka, v ktorom je."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush se ne more posodobiti, ker ne more pisati v mapo, v kateri je."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush kan inte uppdatera sig själv eftersom den inte kan skriva till mappen den ligger i."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush, bulunduğu klasöre yazamadığı için kendini güncelleyemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush не може оновитися, бо не може записувати в папку, де він розташований."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush không thể tự cập nhật vì không thể ghi vào thư mục chứa nó."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 無法寫入所在的檔案夾，因此無法自行更新。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 无法写入所在的文件夹，因此无法自行更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 無法寫入所在的檔案夾，因此無法自行更新。"
          }
        }
      }
    },
    "AutoHush can’t control %@ without Accessibility access." : {
      "comment" : "Settings → General, under the media player, while Accessibility isn't allowed; %@ is the player",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لـ AutoHush التحكم في %@ بدون الوصول إلى تسهيلات الاستخدام."
