    "No button changed in %@. Make sure it’s paused, then click It’s Paused again." : {
      "comment" : "Under the step “Pause it yourself” after “It’s Paused” was clicked while nothing had changed on the web app's page; %@ is the web app",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتغير أي زر في %@. تأكّد من أنه متوقف مؤقتًا، ثم انقر على «متوقف مؤقتًا» مرة أخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cap botó no ha canviat a %@. Assegura’t que estigui en pausa i torna a fer clic a «Està en pausa»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V aplikaci %@ se žádné tlačítko nezměnilo. Ujistěte se, že je pozastavená, a znovu klikněte na „Pozastaveno“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen knap ændrede sig i %@. Sørg for, at den er sat på pause, og klik på ”På pause” igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %@ hat sich keine Taste geändert. Prüfe, ob pausiert ist, und klicke erneut auf „Ist pausiert“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν άλλαξε κανένα κουμπί στην εφαρμογή %@. Βεβαιωθείτε ότι είναι σε παύση και κάντε ξανά κλικ στο «Σε παύση»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún botón ha cambiado en %@. Asegúrate de que esté en pausa y vuelve a hacer clic en «Está en pausa»."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún botón ha cambiado en %@. Asegúrate de que esté en pausa y vuelve a hacer clic en «Está en pausa»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikään painike ei muuttunut apissa %@. Varmista, että se on keskeytetty, ja osoita uudelleen ”Keskeytetty”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun bouton n’a changé dans %@. Vérifiez qu’il est en pause, puis cliquez à nouveau sur « En pause »."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun bouton n’a changé dans %@. Vérifiez qu’il est en pause, puis cliquez à nouveau sur « En pause »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שום כפתור לא השתנה ב-%@. יש לוודא שהוא מושהה, ואז ללחוץ שוב על “זה מושהה”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ में कोई बटन नहीं बदला। पक्का करें कि वह पॉज़ है, फिर दोबारा “पॉज़ है” पर क्लिक करें।"
          }
