          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush, %@ uygulamasını kısa bir süre duraklatır, sonra yeniden oynatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush на мить призупинить програму %@, а потім відновить відтворення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush tạm dừng %@ trong giây lát, rồi phát lại."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 會將 %@ 暫停片刻，然後繼續播放。"
