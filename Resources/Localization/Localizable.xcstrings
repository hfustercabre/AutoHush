          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush asentaa päivityksen, kun se ei pidä soitintasi keskeytettynä, ja kertoo siitä jälkeenpäin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
