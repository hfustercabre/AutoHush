          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si una extensió del Safari demana accés al lloc, respon-li primer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud rozšíření Safari požádá o přístup k webu, nejdřív na to odpovězte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis en Safari-udvidelse beder om adgang til webstedet, så svar på den først."
