    "%@ is the only supported music player on this Mac. AutoHush also works with %@." : {
      "comment" : "Welcome window; the installed music player, then the other supported ones, e.g. “Apple Music and Deezer”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ هو مشغّل الموسيقى الوحيد المدعوم على جهاز Mac هذا. يعمل AutoHush أيضًا مع %2$@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ és l'únic reproductor de música compatible d'aquest Mac. L'AutoHush també funciona amb %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist der einzige unterstützte Musikplayer auf diesem Mac. AutoHush funktioniert auch mit %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is the only supported music player on this Mac. AutoHush also works with %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ es el único reproductor de música compatible en este Mac. AutoHush también funciona con %2$@."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ es el único reproductor de música compatible en esta Mac. AutoHush también funciona con %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est le seul lecteur de musique compatible sur ce Mac. AutoHush fonctionne aussi avec %2$@."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est le seul lecteur de musique compatible sur ce Mac. AutoHush fonctionne aussi avec %2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस Mac पर समर्थित एकमात्र म्यूज़िक प्लेयर %1$@ है। AutoHush %2$@ के साथ भी काम करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ adalah satu-satunya pemutar musik yang didukung di Mac ini. AutoHush juga berfungsi dengan %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è l'unico lettore musicale supportato su questo Mac. AutoHush funziona anche con %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacで対応している音楽プレーヤーは%1$@だけです。AutoHushは%2$@にも対応しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 지원되는 음악 플레이어는 %1$@뿐입니다. AutoHush는 %2$@도 지원합니다."
          }
        },
        "pt" : {
