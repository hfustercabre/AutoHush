    "Adding %@ instead stops adding it." : {
      "comment" : "Message of the alert when a suggested web app is clicked while Add a Web App adds another web app; %@ is the address of the one clicked, e.g. music.example.com",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إضافة %@ بدلاً من ذلك توقف الإضافة الحالية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegir %@ en lloc seu deixa d’afegir-la."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidání webu %@ místo toho přeruší stávající přidávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis %@ tilføjes i stedet, stopper denne tilføjelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird stattdessen %@ hinzugefügt, wird dieses Hinzufügen gestoppt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η προσθήκη του %@ αντ’ αυτού διακόπτει την τρέχουσα προσθήκη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir %@ en su lugar deja de añadirla."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregar %@ en su lugar deja de agregarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohteen %@ lisääminen sen sijaan lopettaa tämän lisäämisen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter %@ à la place arrête cet ajout."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter %@ à la place arrête cet ajout."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוספת %@ במקום תפסיק את ההוספה הנוכחית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके बजाय %@ जोड़ने से मौजूदा जोड़ना रुक जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodavanje stranice %@ umjesto toga prekida trenutačno dodavanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha helyette a(z) %@ kerül hozzáadásra, ez a hozzáadás leáll."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambahkan %@ sebagai gantinya menghentikan penambahan ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungere %@ al suo posto interrompe l’aggiunta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代わりに%@を追加すると、この追加は停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대신 %@을(를) 추가하면 이 추가가 중단됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambah %@ sebaliknya menghentikan penambahan ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å legge til %@ i stedet stopper dette tillegget."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je in plaats daarvan %@ toevoegt, stopt dit toevoegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodanie zamiast tego witryny %@ przerywa obecne dodawanie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar %@ em vez disso interrompe a adição."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar %@ em vez disso interrompe a adição."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adăugarea site-ului %@ în schimb oprește adăugarea curentă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавление вместо этого %@ остановит текущее добавление."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridanie webu %@ namiesto toho preruší súčasné pridávanie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajanje strani %@ namesto tega ustavi trenutno dodajanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att lägga till %@ i stället avbryter tillägget."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเพิ่ม %@ แทนจะหยุดการเพิ่มนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunun yerine %@ eklemek, mevcut eklemeyi durdurur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додавання натомість %@ зупинить поточне додавання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm %@ thay vào đó sẽ dừng việc thêm hiện tại."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改為加入 %@ 會停止這次加入。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改为添加 %@ 会停止此次添加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改為加入 %@ 會停止此次加入。"
          }
        }
      }
