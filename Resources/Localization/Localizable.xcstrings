        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το AutoHush λαμβάνει την ενημέρωση και σας ειδοποιεί. Το αρχείο φυλάσσεται για 7 ημέρες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush la descarga y te avisa. Guarda la descarga durante 7 días."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush la descarga y te avisa. Guarda la descarga durante 7 días."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush lataa päivityksen ja kertoo siitä sinulle. Latausta säilytetään 7 päivää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush la télécharge et vous prévient. Le téléchargement est conservé 7 jours."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush la télécharge et vous prévient. Le téléchargement est conservé 7 jours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush इसे डाउनलोड करता है और आपको बताता है। डाउनलोड 7 दिनों तक रखा जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush preuzima ažuriranje i obavještava vas. Preuzimanje se čuva 7 dana."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az AutoHush letölti a frissítést, és értesíti Önt. A letöltést 7 napig megőrzi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
