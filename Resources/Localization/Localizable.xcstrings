          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikasi untuk AutoHush mati: ikonnya di bar menu menunjukkan saat pembaruan ditemukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
