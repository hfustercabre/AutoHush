    "Stopped. Everything was put back as it was." : {
      "comment" : "Add an App window, under the check's step once it was stopped",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الإيقاف. أُعيد كل شيء كما كان."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aturada. Tot ha tornat a quedar com estava."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastaveno. Vše se vrátilo do původního stavu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppet. Alt er sat tilbage, som det var."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestoppt. Alles wurde wiederhergestellt, wie es war."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διακόπηκε. Όλα επανήλθαν όπως ήταν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detenida. Todo ha vuelto a quedar como estaba."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detenida. Todo volvió a quedar como estaba."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pysäytetty. Kaikki palautettiin ennalleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêtée. Tout a été remis comme avant."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêtée. Tout a été remis comme avant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
