          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush l'installe quand il ne retient pas votre lecteur en pause, puis vous prévient."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush इसे तब इंस्टॉल करता है जब वह आपका प्लेयर पॉज़ करके नहीं रख रहा हो, और बाद में आपको बताता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush instalira ažuriranje kad ne drži vaš reproduktor pauziranim, a zatim vas obavijesti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az AutoHush akkor telepíti a frissítést, amikor nem tartja szüneteltetve a lejátszóját, és utána értesíti Önt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush menginstalnya saat tidak sedang menahan jeda pemutar Anda, lalu memberi tahu Anda setelahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
