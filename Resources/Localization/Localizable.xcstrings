        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoveel wordt het Mac-volume hooguit verlaagd als je speler wordt hervat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najwięcej, o ile spada głośność Maca, gdy odtwarzacz się wznawia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O máximo que o volume do Mac baixa quando seu player retoma."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O máximo que o volume do Mac baixa quando o seu leitor retoma."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât de mult scade cel mult volumul Macului când playerul dvs. se reia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насколько максимум снижается громкость Mac, когда плеер возобновляется."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najviac, o koľko sa zníži hlasitosť Macu, keď sa váš prehrávač obnoví."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Največ, za kolikor se zniža glasnost Maca, ko se vaš predvajalnik nadaljuje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det mesta Macens volym sänks när din spelare återupptas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระดับเสียงของ Mac ที่ลดลงได้มากที่สุดเมื่อตัวเล่นของคุณเล่นต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynatıcınız sürdürülürken Mac’in sesinin en fazla ne kadar kısılacağı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наскільки щонайбільше знижується гучність Mac, коли ваш програвач відновлюється."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mức tối đa âm lượng Mac được giảm khi trình phát của bạn tiếp tục."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的播放器恢復時，Mac 音量最多調低的幅度。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的播放器恢复时，Mac 音量最多调低的幅度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的播放器恢復時，Mac 音量最多調低的幅度。"
          }
        }
      }
    },
    "The screen dims except the progress panel. Escape or Stop ends the check, and they work again whenever AutoHush asks you something." : {
      "comment" : "The window shown before a check starts, under “Mouse and keyboard are blocked”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُعتَّم الشاشة باستثناء لوحة التقدّم. يُنهي مفتاح Esc أو «إيقاف» الفحص، ويعود الماوس ولوحة المفاتيح إلى العمل كلما سألك AutoHush عن شيء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla s’enfosqueix, excepte el tauler del progrés. Esc o «Atura» acaba la comprovació, i el ratolí i el teclat tornen a funcionar sempre que l’AutoHush et pregunta alguna cosa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrazovka se ztlumí kromě panelu s průběhem. Kontrolu ukončí klávesa Esc nebo „Zastavit“ a myš a klávesnice znovu fungují, kdykoli se vás AutoHush na něco ptá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skærmen dæmpes, undtagen panelet med forløbet. Esc eller ”Stop” afslutter kontrollen, og mus og tastatur virker igen, når AutoHush spørger dig om noget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bildschirm wird abgedunkelt, außer dem Fortschrittsfenster. Esc oder „Stoppen“ beendet die Prüfung, und Maus und Tastatur funktionieren wieder, wann immer AutoHush dich etwas fragt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η οθόνη σκουραίνει, εκτός από το πλαίσιο της προόδου. Το Escape ή η «Διακοπή» τερματίζει τον έλεγχο, και το ποντίκι και το πληκτρολόγιο λειτουργούν ξανά όποτε το AutoHush σας ρωτά κάτι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla se oscurece, salvo el panel del progreso. Esc o «Detener» termina la comprobación, y el ratón y el teclado vuelven a funcionar siempre que AutoHush te pregunta algo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla se oscurece, salvo el panel del progreso. Esc o «Detener» termina la verificación, y el mouse y el teclado vuelven a funcionar siempre que AutoHush te pregunta algo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttö himmenee edistymispaneelia lukuun ottamatta. Esc tai ”Pysäytä” lopettaa tarkistuksen, ja hiiri ja näppäimistö toimivat taas aina, kun AutoHush kysyy sinulta jotain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écran s’assombrit, sauf le panneau de progression. Échap ou « Arrêter » met fin à la vérification, et la souris et le clavier fonctionnent à nouveau dès qu’AutoHush vous demande quelque chose."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écran s’assombrit, sauf le panneau de progression. Échap ou « Arrêter » met fin à la vérification, et la souris et le clavier fonctionnent à nouveau dès qu’AutoHush vous demande quelque chose."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המסך מוחשך פרט לחלונית ההתקדמות. Esc או “עצירה” מסיימים את הבדיקה, והעכבר והמקלדת פועלים שוב בכל פעם ש-AutoHush שואל אותך משהו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रगति पैनल को छोड़कर स्क्रीन धुंधली हो जाती है। Escape या “रोकें” जाँच ख़त्म करता है, और जब भी AutoHush आपसे कुछ पूछता है, माउस और कीबोर्ड फिर से काम करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaslon se zatamnjuje, osim ploče s napretkom. Escape ili „Zaustavi” završava provjeru, a miš i tipkovnica ponovno rade kad god vas AutoHush nešto pita."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A képernyő elsötétül, kivéve a folyamatpanelt. Az Esc vagy a „Leállítás” befejezi az ellenőrzést, az egér és a billentyűzet pedig újra működik, valahányszor az AutoHush kérdez valamit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar meredup, kecuali panel kemajuan. Escape atau “Hentikan” mengakhiri pemeriksaan, dan mouse serta papan ketik berfungsi lagi setiap kali AutoHush menanyakan sesuatu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo schermo si oscura, tranne il pannello dell’avanzamento. Esc o «Interrompi» termina la verifica, e mouse e tastiera tornano a funzionare ogni volta che AutoHush ti chiede qualcosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進行状況のパネルを除いて画面が暗くなります。Escキーまたは「停止」でチェックを終了できます。AutoHushから何か尋ねられたときは、マウスとキーボードが再び使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 상황 패널을 제외한 화면이 어두워집니다. Esc 키나 ‘중단’을 누르면 검사가 끝나며, AutoHush가 무언가를 물을 때마다 마우스와 키보드를 다시 사용할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrin menjadi malap kecuali panel kemajuan. Escape atau “Henti” menamatkan semakan, dan tetikus serta papan kekunci berfungsi semula setiap kali AutoHush bertanya sesuatu kepada anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjermen dempes, unntatt fremdriftspanelet. Esc eller «Stopp» avslutter kontrollen, og mus og tastatur fungerer igjen når AutoHush spør deg om noe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het scherm wordt gedimd, behalve het voortgangspaneel. Esc of ‘Stop’ beëindigt de controle, en muis en toetsenbord werken weer zodra AutoHush je iets vraagt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran zostaje przyciemniony, z wyjątkiem panelu postępu. Klawisz Esc lub „Zatrzymaj” kończy sprawdzanie, a mysz i klawiatura znów działają, gdy tylko AutoHush o coś pyta."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tela escurece, exceto o painel do progresso. Esc ou “Parar” encerra a verificação, e o mouse e o teclado voltam a funcionar sempre que o AutoHush pergunta algo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ecrã escurece, exceto o painel do progresso. Esc ou “Parar” termina a verificação, e o rato e o teclado voltam a funcionar sempre que o AutoHush lhe pergunta algo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ecranul se întunecă, în afară de panoul cu progresul. Escape sau „Opriți” încheie verificarea, iar mouse-ul și tastatura funcționează din nou ori de câte ori AutoHush vă întreabă ceva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экран затемняется, кроме панели с ходом проверки. Escape или «Остановить» завершает проверку, а мышь и клавиатура снова работают, когда AutoHush что-то у вас спрашивает."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrazovka stmavne okrem panela s priebehom. Kontrolu ukončí kláves Esc alebo „Zastaviť“ a myš a klávesnica znova fungujú vždy, keď sa vás AutoHush na niečo pýta."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaslon se zatemni, razen plošče z napredkom. Escape ali »Ustavi« konča preverjanje, miška in tipkovnica pa spet delujeta, kadar vas AutoHush kaj vpraša."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skärmen dämpas, utom förloppspanelen. Esc eller ”Stoppa” avslutar kontrollen, och mus och tangentbord fungerar igen när AutoHush frågar dig något."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หน้าจอจะหรี่ลงยกเว้นแผงความคืบหน้า กด Esc หรือ “หยุด” เพื่อสิ้นสุดการตรวจสอบ และเมาส์กับแป้นพิมพ์จะใช้ได้อีกครั้งทุกครั้งที่ AutoHush ถามคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran, ilerleme paneli dışında kararır. Esc tuşu veya “Durdur” denetimi bitirir; AutoHush size bir şey sorduğunda fare ve klavye yeniden çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Екран тьмяніє, крім панелі з перебігом. Клавіша Esc або «Зупинити» завершує перевірку, а миша й клавіатура знову працюють щоразу, коли AutoHush вас щось запитує."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màn hình tối đi, trừ bảng tiến trình. Esc hoặc “Dừng” sẽ kết thúc lần kiểm tra, và chuột cùng bàn phím hoạt động lại mỗi khi AutoHush hỏi bạn điều gì."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除了進度面板外，螢幕會變暗。按 Esc 鍵或「停止」便可結束檢查；每當 AutoHush 向你詢問時，滑鼠和鍵盤會恢復可用。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除进度面板外，屏幕会变暗。按 Esc 键或“停止”即可结束检查；每当 AutoHush 向你询问时，鼠标和键盘会恢复可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除了進度面板外，螢幕會變暗。按 Esc 鍵或「停止」即可結束檢查；每當 AutoHush 向你詢問時，滑鼠和鍵盤會恢復可用。"
          }
        }
      }
    },
    "Then click It’s Paused. AutoHush sees which button changed." : {
      "comment" : "Under the step “Pause it yourself” while AutoHush learns a web app's controls; “It’s Paused” is the button under it",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثم انقر على «متوقف مؤقتًا». يرى AutoHush أي زر تغيّر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Després fes clic a «Està en pausa». L’AutoHush veu quin botó ha canviat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pak klikněte na „Pozastaveno“. AutoHush uvidí, které tlačítko se změnilo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik derefter på ”På pause”. AutoHush ser, hvilken knap der ændrede sig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke dann auf „Ist pausiert“. AutoHush sieht, welche Taste sich geändert hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετά κάντε κλικ στο «Σε παύση». Το AutoHush βλέπει ποιο κουμπί άλλαξε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luego haz clic en «Está en pausa». AutoHush ve qué botón ha cambiado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luego haz clic en «Está en pausa». AutoHush ve qué botón ha cambiado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoita sitten ”Keskeytetty”. AutoHush näkee, mikä painike muuttui."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez ensuite sur « En pause ». AutoHush voit quel bouton a changé."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez ensuite sur « En pause ». AutoHush voit quel bouton a changé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אחר כך יש ללחוץ על “זה מושהה”. AutoHush יראה איזה כפתור השתנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फिर “पॉज़ है” पर क्लिक करें। AutoHush देखता है कि कौन-सा बटन बदला।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatim kliknite „Pauzirano”. AutoHush vidi koja se tipka promijenila."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezután kattintson a „Szüneteltetve” gombra. Az AutoHush látja, melyik gomb változott meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lalu klik “Dijeda”. AutoHush melihat tombol mana yang berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poi fai clic su «In pausa». AutoHush vede quale pulsante è cambiato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次に「一時停止中」をクリックします。AutoHushが変化したボタンを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그런 다음 ‘일시 정지됨’을 클릭하십시오. AutoHush가 어떤 버튼이 바뀌었는지 확인합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemudian klik “Sudah Dijeda”. AutoHush melihat butang yang berubah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikk deretter på «På pause». AutoHush ser hvilken knapp som endret seg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik dan op ‘Gepauzeerd’. AutoHush ziet welke knop is veranderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Następnie kliknij „Wstrzymane”. AutoHush zobaczy, który przycisk się zmienił."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois clique em “Está pausado”. O AutoHush vê qual botão mudou."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois clique em “Em pausa”. O AutoHush vê que botão mudou."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoi faceți clic pe „Pe pauză”. AutoHush vede ce buton s-a schimbat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затем нажмите «На паузе». AutoHush увидит, какая кнопка изменилась."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potom kliknite na „Pozastavené“. AutoHush uvidí, ktoré tlačidlo sa zmenilo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nato kliknite »Zaustavljeno«. AutoHush vidi, kateri gumb se je spremenil."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicka sedan på ”Pausad”. AutoHush ser vilken knapp som ändrades."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
