    "%@ pauses and resumes without fading: AutoHush can't change its volume." : {
      "comment" : "Settings → Fades, under the dimmed fade settings; %@ is the media player, e.g. TIDAL",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُوقَف %@ مؤقتًا ويُستأنف دون تلاشٍ: لا يستطيع AutoHush تغيير مستوى صوته."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es posa en pausa i es reprèn sense esvaïment: l'AutoHush no en pot canviar el volum."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace %@ se pozastavuje a obnovuje bez prolínání: AutoHush nemůže měnit její hlasitost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sættes på pause og genoptages uden at tone ud og ind: AutoHush kan ikke ændre dens lydstyrke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird ohne Ein- und Ausblenden pausiert und fortgesetzt: AutoHush kann seine Lautstärke nicht ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ τίθεται σε παύση και συνεχίζει χωρίς σταδιακή αλλαγή έντασης: το AutoHush δεν μπορεί να αλλάξει την έντασή του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se pausa y se reanuda sin fundido: AutoHush no puede cambiar su volumen."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se pausa y se reanuda sin fundido: AutoHush no puede cambiar su volumen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ keskeytetään ja sen toistoa jatketaan ilman häivytystä: AutoHush ei voi muuttaa sen äänenvoimakkuutta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est mis en pause et repris sans fondu : AutoHush ne peut pas changer son volume."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est mis en pause et repris sans fondu : AutoHush ne peut pas changer son volume."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ बिना फ़ेड के पॉज़ और फिर से शुरू होता है: AutoHush इसका वॉल्यूम नहीं बदल सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija %@ pauzira se i nastavlja bez utišavanja: AutoHush ne može mijenjati njezinu glasnoću."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ szüneteltetése és folytatása halkítás nélkül történik: az AutoHush nem tudja módosítani a hangerejét."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dijeda dan dilanjutkan tanpa memudar: AutoHush tidak dapat mengubah volumenya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ viene messo in pausa e ripreso senza dissolvenza: AutoHush non può cambiarne il volume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はフェードせずに一時停止・再開します。AutoHushはその音量を変更できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 페이드 없이 일시 정지되고 재개됩니다. AutoHush가 음량을 변경할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ settes på pause og gjenopptas uten å tone ut og inn: AutoHush kan ikke endre volumet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pauzeert en hervat zonder vervaging: AutoHush kan het volume niet wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja %@ jest wstrzymywana i wznawiana bez wyciszania: AutoHush nie może zmieniać jej głośności."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é pausado e retomado sem fade: o AutoHush não consegue alterar o volume dele."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é colocado em pausa e retomado sem fade: o AutoHush não consegue alterar o volume."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ este pus pe pauză și reluat fără estompare: AutoHush nu îi poate modifica volumul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ставится на паузу и продолжает воспроизведение без затухания: AutoHush не может изменить его громкость."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apka %@ sa pozastavuje a obnovuje bez prelínania: AutoHush nemôže meniť jej hlasitosť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija %@ se zaustavi in nadaljuje brez pojemanja: AutoHush ne more spreminjati njene glasnosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pausas och återupptas utan tonande: AutoHush kan inte ändra dess volym."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sesi kısılıp açılmadan duraklatılır ve sürdürülür: AutoHush bu uygulamanın ses düzeyini değiştiremez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ призупиняється й відновлюється без згасання: AutoHush не може змінювати його гучність."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ được tạm dừng và tiếp tục phát mà không giảm dần âm lượng: AutoHush không thể thay đổi âm lượng của ứng dụng này."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 會直接暫停和繼續播放，不會淡入淡出：AutoHush 無法更改它的音量。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
