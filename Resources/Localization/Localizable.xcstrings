        }
      }
    },
    "AutoHush pauses it while other apps play audio, then resumes it. You can change it anytime in the menu or Settings." : {
      "comment" : "Welcome window, at its top beside AutoHush's icon, under the title “Choose Your Media Player”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقفه AutoHush مؤقتًا بينما تُشغّل التطبيقات الأخرى الصوت، ثم يستأنفه. يمكنك تغييره في أي وقت من القائمة أو الإعدادات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’AutoHush el posa en pausa mentre altres apps reprodueixen àudio, i després el reprèn. El pots canviar quan vulguis des del menú o a la configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ho pozastaví, když jiné aplikace přehrávají zvuk, a potom ho obnoví. Kdykoli ho můžete změnit v nabídce nebo v nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush sætter den på pause, mens andre apps afspiller lyd, og genoptager den bagefter. Du kan altid ændre den i menuen eller i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pausiert ihn, während andere Apps Audio abspielen, und setzt ihn danach fort. Du kannst ihn jederzeit im Menü oder in den Einstellungen ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το AutoHush τη θέτει σε παύση όσο άλλες εφαρμογές αναπαράγουν ήχο και μετά τη συνεχίζει. Μπορείτε να την αλλάξετε οποιαδήποτε στιγμή από το μενού ή τις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush lo pausa mientras otras apps reproducen audio, y después lo reanuda. Puedes cambiarlo cuando quieras desde el menú o en Ajustes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush lo pausa mientras otras apps reproducen audio, y después lo reanuda. Puedes cambiarlo cuando quieras desde el menú o en Configuración."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush keskeyttää sen, kun muut apit toistavat ääntä, ja jatkaa sitten. Voit vaihtaa sen milloin tahansa valikosta tai asetuksista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush le met en pause pendant que d’autres apps lisent du son, puis le relance. Vous pouvez le changer à tout moment dans le menu ou les Réglages."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush le met en pause pendant que d’autres apps lisent du son, puis le relance. Vous pouvez le changer à tout moment dans le menu ou les Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush משהה אותו בזמן שאפליקציות אחרות מנגנות, ואז מחדש את הניגון. אפשר להחליף אותו בכל עת בתפריט או בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब दूसरे ऐप्स ऑडियो चलाते हैं, तो AutoHush इसे पॉज़ करता है और फिर से शुरू करता है। आप इसे कभी भी मेनू या सेटिंग में बदल सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ga pauzira dok druge aplikacije reproduciraju zvuk, a zatim ga nastavlja. Možete ga promijeniti bilo kada u izborniku ili u postavkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az AutoHush szünetelteti, amíg más appok hangot játszanak le, majd folytatja. Bármikor módosíthatja a menüben vagy a beállításokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush menjedanya saat app lain memutar audio, lalu melanjutkannya. Anda dapat mengubahnya kapan saja di menu atau di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush lo mette in pausa mentre altre app riproducono audio, poi lo riprende. Puoi cambiarlo in qualsiasi momento dal menu o nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのAppがオーディオを再生している間はプレーヤーを一時停止し、その後再開します。メニューまたは設定でいつでも変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱이 오디오를 재생하는 동안 플레이어를 일시 정지하고, 이후 다시 재생합니다. 메뉴나 설정에서 언제든지 변경할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush menjedanya semasa app lain memainkan audio, kemudian menyambungnya semula. Anda boleh menukarnya pada bila-bila masa dalam menu atau Seting."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush setter den på pause mens andre apper spiller av lyd, og gjenopptar den etterpå. Du kan når som helst endre den i menyen eller i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pauzeert hem terwijl andere apps audio afspelen, en hervat hem daarna. Je kunt dit altijd wijzigen in het menu of in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush wstrzymuje go, gdy inne aplikacje odtwarzają dźwięk, a potem go wznawia. Możesz go zmienić w każdej chwili w menu lub w ustawieniach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush o pausa enquanto outros apps reproduzem áudio e depois o retoma. Você pode alterá-lo a qualquer momento no menu ou nos Ajustes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush coloca-o em pausa enquanto outras apps reproduzem áudio, e depois retoma-o. Pode alterá-lo a qualquer momento no menu ou nas Definições."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush îl pune pe pauză cât timp alte aplicații redau sunet, apoi îl reia. Îl puteți schimba oricând din meniu sau din Configurări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ставит его на паузу, пока другие приложения воспроизводят звук, и затем возобновляет. Его можно сменить в любое время в меню или в настройках."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ho pozastaví, keď iné apky prehrávajú zvuk, a potom ho obnoví. Kedykoľvek ho môžete zmeniť v menu alebo v nastaveniach."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ga zaustavi, medtem ko druge aplikacije predvajajo zvok, in ga nato nadaljuje. Kadar koli ga lahko spremenite v meniju ali v nastavitvah."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pausar den medan andra appar spelar upp ljud och återupptar den sedan. Du kan ändra den när som helst i menyn eller i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush จะหยุดพักตัวเล่นขณะที่แอปอื่นเล่นเสียง แล้วเล่นต่อ คุณเปลี่ยนตัวเล่นได้ทุกเมื่อในเมนูหรือการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer uygulamalar ses çalarken AutoHush onu duraklatır, ardından sürdürür. Bunu istediğiniz zaman menüden veya Ayarlar’dan değiştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush призупиняє його, поки інші програми відтворюють звук, а потім відновлює. Його можна змінити будь-коли в меню або в параметрах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush tạm dừng nó khi các ứng dụng khác phát âm thanh, rồi tiếp tục phát. Bạn có thể thay đổi bất cứ lúc nào trong menu hoặc trong Cài đặt."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在其他 App 播放音訊時，AutoHush 會暫停它，之後繼續播放。你可以隨時在選單或設定中更改。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在其他 App 播放音频时，AutoHush 会暂停它，之后继续播放。你可以随时在菜单或设置中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在其他 App 播放音訊時，AutoHush 會暫停它，之後繼續播放。你可以隨時在選單或設定中更改。"
          }
        }
      }
    },
    "AutoHush supports %@ already: choose it among the media players." : {
      "comment" : "The window that lists the apps Add an App can check, after Other App… picked a supported player; %@ is it",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يدعم AutoHush التطبيق %@ بالفعل: اختره من بين مشغّلات الوسائط."
          }
        },
        "ca" : {
          "stringUnit" : {
