          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notificações do AutoHush estão desativadas: o ícone dele na barra de menus mostra quando uma atualização é encontrada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
