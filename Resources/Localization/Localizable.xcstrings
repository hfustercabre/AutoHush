    "AutoHush can't update itself, because it can't write to the folder it's in." : {
      "comment" : "Settings, under the update choices",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'AutoHush no es pot actualitzar sol, perquè no pot escriure a la carpeta on és."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush kann sich nicht selbst aktualisieren, weil es nicht in seinen Ordner schreiben kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush no puede actualizarse solo porque no puede escribir en la carpeta donde está."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush no puede actualizarse solo porque no puede escribir en la carpeta donde está."
