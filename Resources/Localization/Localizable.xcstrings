    "The download isn't signed with the same certificate as AutoHush, so it wasn't installed." : {
      "comment" : "Update install error",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التنزيل غير موقّع بنفس شهادة AutoHush، لذلك لم يُثبَّت."
