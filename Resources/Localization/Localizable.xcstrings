        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dozwolone w Ustawieniach systemowych: zadziała po ponownym otwarciu AutoHush. To, co znalazło sprawdzanie, zostaje zachowane."
