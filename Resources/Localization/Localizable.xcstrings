          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقف موسيقاك مؤقتًا بينما تُشغّل التطبيقات الأخرى الصوت، ثم يستأنفها بعد ذلك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posa la música en pausa mentre altres apps reprodueixen àudio i la reprèn després."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert deine Musik, während andere Apps Audio abspielen, und setzt sie danach fort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa tu música mientras otras apps reproducen audio y la reanuda después."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa tu música mientras otras apps reproducen audio y la reanuda después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met votre musique en pause pendant que d'autres apps lisent du son, puis la reprend."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met votre musique en pause pendant que d'autres apps lisent du son, puis la reprend."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरे ऐप्स के ऑडियो चलाने पर आपका संगीत पॉज़ करता है, और बाद में फिर से शुरू करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjeda musik Anda saat app lain memutar audio, lalu melanjutkannya setelahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette in pausa la musica mentre altre app riproducono audio e poi la riprende."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのAppがオーディオを再生している間は音楽を一時停止し、終わると再開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱이 오디오를 재생하는 동안 음악을 일시 정지하고, 끝나면 다시 재생합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa sua música enquanto outros apps reproduzem áudio e a retoma depois."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa a sua música enquanto outras apps reproduzem áudio e retoma-a depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставит вашу музыку на паузу, пока другие приложения воспроизводят звук, и затем возобновляет её."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer uygulamalar ses çalarken müziğinizi duraklatır ve ardından sürdürür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạm dừng nhạc của bạn khi các ứng dụng khác phát âm thanh và tiếp tục phát sau đó."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在其他 App 播放音訊時暫停你的音樂，並在之後繼續播放。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在其他 App 播放音频时暂停你的音乐，并在之后继续播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在其他 App 播放音訊時暫停你的音樂，並在之後繼續播放。"
          }
        }
      }
