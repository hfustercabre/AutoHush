          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קורא את התפריטים והדף של %@, מזיז את החלון שלו וחוסם את העכבר והמקלדת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ के मेनू और पेज पढ़ता है, उसकी विंडो खिसकाता है, और माउस व कीबोर्ड ब्लॉक करता है।"
