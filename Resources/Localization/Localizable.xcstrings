    "In Safari’s Add to Dock window, change the name if you like, then click Add." : {
      "comment" : "Add a Web App window, under the step “Add it to the Dock”, while Safari's own Add to Dock window is open: the user may rename the web app there, then clicks its Add button",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في نافذة «إضافة إلى شريط الأيقونات» في Safari، غيّر الاسم إذا أردت، ثم انقر على «إضافة»."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A la finestra «Afegeix al Dock» del Safari, canvia el nom si vols i fes clic a «Afegeix»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V okně „Přidat do Docku“ v Safari případně změňte název a pak klikněte na „Přidat“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Safaris vindue ”Føj til Dock” kan du ændre navnet, hvis du vil, og derefter klikke på ”Tilføj”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändere im Safari-Fenster „Zum Dock hinzufügen“ den Namen, wenn du möchtest, und klicke dann auf „Hinzufügen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στο παράθυρο «Προσθήκη στο Dock» του Safari, αλλάξτε το όνομα αν θέλετε και μετά κάντε κλικ στο «Προσθήκη»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la ventana «Añadir al Dock» de Safari, cambia el nombre si quieres y haz clic en «Añadir»."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la ventana «Agregar al Dock» de Safari, cambia el nombre si quieres y haz clic en «Agregar»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuta Safarin ”Lisää Dockiin” -ikkunassa nimeä halutessasi ja osoita sitten ”Lisää”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans la fenêtre « Ajouter au Dock » de Safari, modifiez le nom si vous le souhaitez, puis cliquez sur « Ajouter »."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
