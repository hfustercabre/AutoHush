    "How long another app must be audible, so short sounds don’t pause your player." : {
      "comment" : "Settings → Detection, under “Pause playback after”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المدة التي يجب أن يكون فيها صوت تطبيق آخر مسموعًا، حتى لا توقف الأصوات القصيرة مشغّلك مؤقتًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quant de temps s’ha de sentir una altra app, perquè els sons breus no posin en pausa el reproductor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak dlouho musí být jiná aplikace slyšet, aby krátké zvuky nepozastavily váš přehrávač."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor længe en anden app skal være hørbar, så korte lyde ikke sætter din afspiller på pause."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange eine andere App hörbar sein muss, damit kurze Töne deinen Player nicht pausieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόση ώρα πρέπει να ακούγεται μια άλλη εφαρμογή, ώστε οι σύντομοι ήχοι να μη θέτουν σε παύση την εφαρμογή αναπαραγωγής σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto tiempo debe oírse otra app, para que los sonidos breves no pausen tu reproductor."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto tiempo debe escucharse otra app, para que los sonidos breves no pausen tu reproductor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka kauan toisen apin on kuuluttava, jotta lyhyet äänet eivät keskeytä soitintasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée pendant laquelle une autre app doit être audible, pour que les sons brefs ne mettent pas votre lecteur en pause."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée pendant laquelle une autre app doit être audible, pour que les sons brefs ne mettent pas votre lecteur en pause."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה זמן אפליקציה אחרת צריכה להישמע, כדי שצלילים קצרים לא ישהו את הנגן שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी दूसरे ऐप को कितनी देर सुनाई देना चाहिए, ताकि छोटी आवाज़ें आपके प्लेयर को पॉज़ न करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koliko dugo druga aplikacija mora biti čujna, da kratki zvukovi ne pauziraju vaš reproduktor."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mennyi ideig kell hallhatónak lennie egy másik appnak, hogy a rövid hangok ne szüneteltessék a lejátszóját."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berapa lama app lain harus terdengar, agar suara pendek tidak menjeda pemutar Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per quanto tempo un’altra app deve essere udibile, così i suoni brevi non mettono in pausa il lettore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのAppの音が聞こえ続ける必要がある時間です。短い音ではプレーヤーは一時停止しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱의 소리가 들려야 하는 시간으로, 짧은 소리로는 플레이어가 일시 정지되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempoh app lain mesti kedengaran, supaya bunyi pendek tidak menjeda pemain anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor lenge en annen app må høres, slik at korte lyder ikke setter spilleren din på pause."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe lang een andere app hoorbaar moet zijn, zodat korte geluiden je speler niet pauzeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak długo inna aplikacja musi być słyszalna, żeby krótkie dźwięki nie wstrzymywały Twojego odtwarzacza."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por quanto tempo outro app precisa estar audível, para que sons curtos não pausem seu player."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante quanto tempo outra app tem de estar audível, para que os sons curtos não coloquem o seu leitor em pausa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât timp trebuie să se audă o altă aplicație, astfel încât sunetele scurte să nu pună playerul dvs. pe pauză."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как долго другое приложение должно звучать, чтобы короткие звуки не ставили ваш плеер на паузу."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako dlho musí byť iná apka počuť, aby krátke zvuky nepozastavili váš prehrávač."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako dolgo mora biti druga aplikacija slišna, da kratki zvoki ne zaustavijo vašega predvajalnika."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur länge en annan app måste höras, så att korta ljud inte pausar din spelare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระยะเวลาที่ต้องได้ยินเสียงแอปอื่น เพื่อไม่ให้เสียงสั้นๆ หยุดพักตัวเล่นของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir uygulamanın ne kadar süre duyulabilir olması gerektiği; böylece kısa sesler oynatıcınızı duraklatmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скільки часу інша програма має бути чутною, щоб короткі звуки не призупиняли ваш програвач."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian một ứng dụng khác phải phát ra âm thanh nghe được, để những âm thanh ngắn không làm tạm dừng trình phát của bạn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他 App 需持續發出聲音的時間，短暫的聲音不會暫停你的播放器。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他 App 需持续发出声音的时间，短暂的声音不会暂停你的播放器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他 App 需持續發出聲音的時間，短暫的聲音不會暫停你的播放器。"
          }
        }
      }
    },
    "How long another app must be silent. Bridges gaps between tracks and videos." : {
      "comment" : "Settings → Detection, under “Resume playback after”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المدة التي يجب أن يبقى فيها تطبيق آخر صامتًا. تسدّ الفجوات بين المقاطع والفيديوهات."
          }
        },
