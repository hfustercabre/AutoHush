          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ненадолго поставит приложение %@ на паузу, а затем продолжит воспроизведение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush na chvíľu pozastaví apku %@ a potom prehrávanie obnoví."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush za trenutek zaustavi aplikacijo %@, nato pa nadaljuje predvajanje."
          }
        },
        "sv" : {
          "stringUnit" : {
