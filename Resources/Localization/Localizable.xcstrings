    "All apps are removed; those you turned off will pause your player again." : {
      "comment" : "Settings → Sound Sources: what Reset List does, in its confirmation",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُزال كل التطبيقات، وستعود التطبيقات التي أوقفتها إلى إيقاف مشغّلك مؤقتًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’eliminaran totes les apps; les que vas desactivar tornaran a posar el reproductor en pausa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny aplikace se odstraní; ty, které jste vypnuli, budou znovu pozastavovat váš přehrávač."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle apps fjernes; dem, du har slået fra, sætter igen din afspiller på pause."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Apps werden entfernt; die ausgeschalteten pausieren deinen Player wieder."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλες οι εφαρμογές αφαιρούνται· όσες απενεργοποιήσατε θα θέτουν ξανά την εφαρμογή αναπαραγωγής σας σε παύση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todas las apps; las que desactivaste volverán a pausar tu reproductor."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todas las apps; las que desactivaste volverán a pausar tu reproductor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki apit poistetaan; pois päältä laittamasi apit keskeyttävät soittimesi taas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les apps sont retirées ; celles que vous avez désactivées mettront de nouveau votre lecteur en pause."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les apps sont retirées; celles que vous avez désactivées mettront de nouveau votre lecteur en pause."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל האפליקציות יוסרו; אלה שכובו ישהו שוב את הנגן שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर ऐप हटा दिया जाता है; जिन ऐप्स को आपने बंद किया था वे फिर से आपका प्लेयर पॉज़ करेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve će se aplikacije ukloniti; one koje ste isključili ponovno će pauzirati vaš reproduktor."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden app eltávolításra kerül; a kikapcsolt appok ismét szüneteltetik a lejátszóját."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua app dihapus; app yang Anda matikan akan kembali menjeda pemutar Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le app vengono rimosse; quelle che hai disattivato metteranno di nuovo in pausa il lettore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのAppが削除され、オフにしたAppでも再びプレーヤーが一時停止するようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 앱이 제거되며, 끈 앱도 다시 플레이어를 일시 정지시킵니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua app dikeluarkan; app yang anda nyahaktifkan akan menjeda pemain anda semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle apper fjernes; de du har slått av, setter spilleren din på pause igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle apps worden verwijderd; apps die je hebt uitgezet pauzeren je speler weer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie aplikacje zostaną usunięte; wyłączone przez Ciebie znów będą wstrzymywać Twój odtwarzacz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os apps serão removidos; os que você desativou voltarão a pausar seu player."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as apps são removidas; as que desativou voltarão a pausar o seu leitor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate aplicațiile sunt eliminate; cele pe care le-ați dezactivat vă vor pune din nou playerul pe pauză."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все приложения будут удалены из списка; выключенные снова будут ставить ваш плеер на паузу."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetky apky sa odstránia; tie, ktoré ste vypli, budú znova pozastavovať váš prehrávač."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vse aplikacije bodo odstranjene; tiste, ki ste jih izklopili, bodo spet zaustavljale vaš predvajalnik."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla appar tas bort; de som du har stängt av pausar din spelare igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปทั้งหมดจะถูกเอาออก แอปที่คุณปิดไว้จะหยุดพักตัวเล่นของคุณอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm uygulamalar kaldırılır; kapattıklarınız oynatıcınızı yeniden duraklatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі програми буде вилучено; вимкнені вами знову призупинятимуть ваш програвач."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi ứng dụng sẽ bị xóa khỏi danh sách; những ứng dụng bạn đã tắt sẽ lại tạm dừng trình phát của bạn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
