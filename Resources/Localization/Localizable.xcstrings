    "It’s downloaded. Click to see what’s new and install it." : {
      "comment" : "Notification text for a downloaded update",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم التنزيل. انقر لمعرفة الجديد وتثبيته."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja s’ha baixat. Fes clic per veure què hi ha de nou i instal·lar-la."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizace je stažená. Klikněte a podívejte se, co je nového, a nainstalujte ji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdateringen er hentet. Klik for at se, hvad der er nyt, og installere den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist geladen. Klicke, um die Neuerungen zu sehen und es zu installieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ενημέρωση λήφθηκε. Κάντε κλικ για να δείτε τι νέο υπάρχει και να την εγκαταστήσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya está descargada. Haz clic para ver las novedades e instalarla."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya está descargada. Haz clic para ver las novedades e instalarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivitys on ladattu. Katso uudet ominaisuudet ja asenna se klikkaamalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle est téléchargée. Cliquez pour voir les nouveautés et l’installer."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle est téléchargée. Cliquez pour voir les nouveautés et l’installer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העדכון הורד. יש ללחוץ כדי לראות מה חדש ולהתקין אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह डाउनलोड हो गया है। नया क्या है देखने और इसे इंस्टॉल करने के लिए क्लिक करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ažuriranje je preuzeto. Kliknite da biste vidjeli što je novo i instalirali ga."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frissítés letöltődött. Kattintson az újdonságok megtekintéséhez és a telepítéséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sudah diunduh. Klik untuk melihat yang baru dan menginstalnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È già scaricato. Fai clic per vedere le novità e installarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード済みです。クリックすると新機能を確認してインストールできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드되었습니다. 클릭하여 새로운 기능을 확인하고 설치하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sudah dimuat turun. Klik untuk melihat perkara baharu dan memasangnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppdateringen er lastet ned. Klikk for å se hva som er nytt og installere den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De update is gedownload. Klik om te zien wat er nieuw is en hem te installeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uaktualnienie zostało pobrane. Kliknij, aby zobaczyć, co nowego, i je zainstalować."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
