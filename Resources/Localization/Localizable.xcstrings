          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác bấm, cuộn và phím bị chặn cho đến khi kết thúc. Esc hoặc “Dừng” sẽ kết thúc lần kiểm tra."
