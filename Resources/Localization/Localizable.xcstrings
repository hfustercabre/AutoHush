    "What apps tell macOS" : {
      "comment" : "Settings, AntiDot mode: a way to detect playing apps",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما تُخبر به التطبيقات macOS"
          }
        },
        "ca" : {
