        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ é o único player de música compatível neste Mac. O AutoHush também funciona com %2$@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ é o único leitor de música compatível neste Mac. O AutoHush também funciona com %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 是这台 Mac 上唯一受支持的音乐播放器。AutoHush 还支持 %2$@。"
