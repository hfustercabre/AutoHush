        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ख़ुद को अपडेट नहीं कर सकता, क्योंकि वह जिस फ़ोल्डर में है उसमें लिख नहीं सकता।"
