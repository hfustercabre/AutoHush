    "Add any other app: a check finds how to pause and play it." : {
      "comment" : "Where media players are offered, under the “Other Apps” heading while no app was added yet, over its Add… tile",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف أي تطبيق آخر: يجد الفحص كيفية إيقافه مؤقتًا وتشغيله."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix qualsevol altra app: una comprovació troba com posar-la en pausa i reproduir-la."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte jakoukoli jinou aplikaci: kontrola zjistí, jak ji pozastavit a přehrát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj en hvilken som helst anden app: en kontrol finder ud af, hvordan den sættes på pause og afspilles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge jede andere App hinzu: Eine Prüfung ermittelt, wie sie sich pausieren und abspielen lässt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε οποιαδήποτε άλλη εφαρμογή: ένας έλεγχος βρίσκει πώς να τη θέσει σε παύση και να την αναπαράγει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade cualquier otra app: una comprobación averigua cómo pausarla y reproducirla."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega cualquier otra app: una verificación averigua cómo pausarla y reproducirla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää mikä tahansa muu appi: tarkistus selvittää, miten sen toisto keskeytetään ja jatketaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
