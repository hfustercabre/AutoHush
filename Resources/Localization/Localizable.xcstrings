    "Pauses your music while other apps play audio, and resumes it afterwards. Works with %@." : {
      "comment" : "About panel; %@ lists the music players it works with, e.g. “Spotify and Apple Music”",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posa la música en pausa mentre altres apps reprodueixen àudio i la reprèn després. Funciona amb %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert deine Musik, während andere Apps Audio abspielen, und setzt sie danach fort. Funktioniert mit %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa tu música mientras otras apps reproducen audio y la reanuda después. Funciona con %@."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa tu música mientras otras apps reproducen audio y la reanuda después. Funciona con %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met votre musique en pause pendant que d'autres apps lisent du son, puis la reprend. Fonctionne avec %@."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met votre musique en pause pendant que d'autres apps lisent du son, puis la reprend. Fonctionne avec %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette in pausa la musica mentre altre app riproducono audio e poi la riprende. Funziona con %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのAppがオーディオを再生している間は音楽を一時停止し、終わると再開します。%@に対応しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱이 오디오를 재생하는 동안 음악을 일시 정지하고, 끝나면 다시 재생합니다. %@와(과) 함께 작동합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa sua música enquanto outros apps reproduzem áudio e a retoma depois. Funciona com %@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa a sua música enquanto outras apps reproduzem áudio e retoma-a depois. Funciona com %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在其他 App 播放音频时暂停你的音乐，并在之后继续播放。支持 %@。"
          }
        },
        "zh-Hant" : {
