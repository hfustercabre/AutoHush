    "Turn an app off to keep your music playing while it makes sound. Right-click an app to remove it from the list." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقف تطبيقًا لتستمر موسيقاك في التشغيل بينما يُصدر صوتًا. انقر بزر الماوس الأيمن على تطبيق لإزالته من القائمة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva una app perquè la música continuï sonant mentre aquesta app fa so. Fes clic amb el botó dret en una app per eliminar-la de la llista."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte eine App aus, damit deine Musik weiterläuft, während sie Ton abspielt. Klicke mit der rechten Maustaste auf eine App, um sie aus der Liste zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva una app para que tu música siga sonando mientras esa app emite sonido. Haz clic con el botón derecho en una app para eliminarla de la lista."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva una app para que tu música siga sonando mientras esa app emite sonido. Haz clic con el botón derecho en una app para eliminarla de la lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez une app pour que votre musique continue pendant qu'elle émet du son. Cliquez sur une app avec le bouton droit pour la retirer de la liste."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez une app pour que votre musique continue pendant qu'elle émet du son. Cliquez sur une app avec le bouton droit pour la retirer de la liste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी ऐप को बंद करें ताकि उसके आवाज़ करते समय आपका संगीत चलता रहे। किसी ऐप को सूची से हटाने के लिए उस पर राइट-क्लिक करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matikan app agar musik Anda tetap diputar saat app tersebut mengeluarkan suara. Klik kanan app untuk menghapusnya dari daftar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva un'app per continuare ad ascoltare la musica mentre emette suoni. Fai clic con il tasto destro su un'app per rimuoverla dall'elenco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appをオフにすると、そのAppが音を出しても音楽は再生を続けます。Appを右クリックするとリストから削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 끄면 해당 앱에서 소리가 나도 음악이 계속 재생됩니다. 목록에서 제거하려면 앱을 오른쪽 클릭하십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative um app para manter sua música tocando enquanto ele emite som. Clique com o botão direito em um app para removê-lo da lista."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative uma app para que a música continue a tocar enquanto essa app emite som. Clique com o botão direito numa app para a remover da lista."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключите приложение, чтобы музыка продолжала играть, пока оно издаёт звук. Чтобы удалить приложение из списка, нажмите на него правой кнопкой мыши."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir uygulama ses çıkarırken müziğinizin çalmaya devam etmesi için o uygulamayı kapatın. Bir uygulamayı listeden kaldırmak için sağ tıklayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt một ứng dụng để nhạc của bạn tiếp tục phát khi ứng dụng đó phát ra âm thanh. Bấm chuột phải vào một ứng dụng để xóa nó khỏi danh sách."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉 App 後，它發出聲音時音樂會繼續播放。在 App 上按一下右鍵即可將其從列表中移除。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭 App 后，它发出声音时音乐会继续播放。右键点按 App 可将其从列表中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉 App 後，它發出聲音時音樂會繼續播放。在 App 上按一下右鍵即可將其從列表中移除。"
          }
        }
      }
    },
