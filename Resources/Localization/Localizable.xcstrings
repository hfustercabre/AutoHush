    "macOS is waiting for you to allow AutoHush in Login Items." : {
      "comment" : "Settings → General, under Launch at login, while macOS waits for the user's approval in Login Items",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينتظر macOS أن تسمح لـ AutoHush في عناصر تسجيل الدخول."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El macOS espera que permetis l’AutoHush a Ítems d’inici."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS čeká, až AutoHush povolíte v položkách po přihlášení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS venter på, at du tillader AutoHush under loginemner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS wartet darauf, dass du AutoHush in den Anmeldeobjekten erlaubst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το macOS περιμένει να επιτρέψετε το AutoHush στα στοιχεία εισόδου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS espera a que permitas AutoHush en Ítems de inicio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
