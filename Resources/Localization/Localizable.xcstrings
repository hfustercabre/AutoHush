    "The check couldn’t finish. Its log says why." : {
      "comment" : "Add an App window, under the check's step when it ended without a result, for another reason (a Show Log button follows)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إكمال الفحص. يوضح سجله السبب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La comprovació no s’ha pogut acabar. El seu registre explica per què."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrolu se nepodařilo dokončit. Proč, uvádí její protokol."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollen kunne ikke gennemføres. Dens log viser hvorfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Prüfung konnte nicht abgeschlossen werden. Das Protokoll nennt den Grund."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο έλεγχος δεν μπόρεσε να ολοκληρωθεί. Το αρχείο καταγραφής του εξηγεί γιατί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La comprobación no ha podido terminar. Su registro explica por qué."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La verificación no pudo terminar. Su registro explica por qué."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkistusta ei voitu viedä loppuun. Sen loki kertoo syyn."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vérification n’a pas pu aboutir. Son journal indique pourquoi."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vérification n’a pas pu aboutir. Son journal indique pourquoi."
          }
        },
