    "Every app is removed, and apps you turned off will pause your music again. Apps reappear as they play audio." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُزال كل التطبيقات، وستعود التطبيقات التي أوقفتها إلى إيقاف موسيقاك مؤقتًا. تظهر التطبيقات مجددًا عندما تُشغّل الصوت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'eliminaran totes les apps, i les que vas desactivar tornaran a posar la música en pausa. Les apps reapareixen a mesura que reprodueixen àudio."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Apps werden entfernt, und Apps, die du ausgeschaltet hast, pausieren deine Musik wieder. Apps erscheinen wieder, sobald sie Audio abspielen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todas las apps, y las que desactivaste volverán a pausar tu música. Las apps reaparecen a medida que reproducen audio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todas las apps, y las que desactivaste volverán a pausar tu música. Las apps reaparecen a medida que reproducen audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les apps sont retirées, et celles que vous avez désactivées mettront de nouveau votre musique en pause. Les apps réapparaissent à mesure qu'elles lisent du son."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les apps sont retirées, et celles que vous avez désactivées mettront de nouveau votre musique en pause. Les apps réapparaissent à mesure qu'elles lisent du son."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर ऐप हटा दिया जाता है, और जिन ऐप्स को आपने बंद किया था वे फिर से आपका संगीत पॉज़ करेंगे। ऑडियो चलाने पर ऐप्स फिर से दिखाई देते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua app dihapus, dan app yang Anda matikan akan kembali menjeda musik Anda. App muncul kembali saat memutar audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le app vengono rimosse, e quelle che hai disattivato metteranno di nuovo in pausa la musica. Le app ricompaiono man mano che riproducono audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのAppが削除され、オフにしたAppでも再び音楽が一時停止するようになります。Appはオーディオを再生すると再び表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 앱이 제거되며, 끈 앱도 다시 음악을 일시 정지시킵니다. 앱은 오디오를 재생하면 다시 나타납니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os apps serão removidos, e os que você desativou voltarão a pausar sua música. Os apps reaparecem conforme reproduzem áudio."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as apps são removidas, e as que desativou voltarão a pausar a música. As apps reaparecem à medida que reproduzem áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все приложения будут удалены из списка, а выключенные снова будут ставить музыку на паузу. Приложения появятся снова, когда воспроизведут звук."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm uygulamalar kaldırılır ve kapattığınız uygulamalar müziğinizi yeniden duraklatır. Uygulamalar ses çaldıkça yeniden görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi ứng dụng sẽ bị xóa khỏi danh sách và những ứng dụng bạn đã tắt sẽ lại tạm dừng nhạc của bạn. Các ứng dụng sẽ xuất hiện lại khi chúng phát âm thanh."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有 App 都會被移除，你關閉的 App 也會再次暫停音樂。App 播放音訊時會重新出現。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有 App 都会被移除，你关闭的 App 也会再次暂停音乐。App 播放音频时会重新出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有 App 都會被移除，你關閉的 App 也會再次暫停音樂。App 播放音訊時會重新出現。"
          }
        }
      }
    },
