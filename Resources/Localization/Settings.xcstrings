    "Whatever’s playing steps aside when something else needs your ears." : {
      "comment" : "Settings → About, centered under the app's icon, name and version: what AutoHush does, as the README's tagline says it: the media player's playback (music, podcasts, videos) pauses while another app plays sound",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أيًّا كان ما يُشغَّل، يتنحّى جانبًا حين يحتاج شيءٌ آخر إلى إصغائك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El que sona s’aparta quan una altra cosa et fa parar l’orella."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co hraje, ustoupí stranou, když vaše uši potřebuje něco jiného."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det, der afspilles, træder til side, når noget andet har brug for dine ører."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was gerade läuft, macht Platz, wenn etwas anderes deine Ohren braucht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ό,τι παίζει κάνει στην άκρη όταν κάτι άλλο χρειάζεται τα αυτιά σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que suena se aparta cuando otra cosa reclama tus oídos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que suena se hace a un lado cuando otra cosa reclama tus oídos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se, mikä soi, väistyy, kun jokin muu tarvitsee korviasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui est en lecture s’efface quand autre chose réclame votre écoute."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui est en lecture s’efface quand autre chose réclame votre écoute."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל מה שמתנגן זז הצידה כשמשהו אחר צריך את האוזניים שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब कोई और आवाज़ आपका ध्यान माँगे, तो जो भी चल रहा हो, वह रास्ता दे देता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ono što svira povlači se u stranu kad nešto drugo treba vaše uši."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ami szól, félreáll, amikor valami másnak szüksége van a fülére."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa pun yang sedang diputar menepi sejenak saat ada hal lain yang perlu Anda dengar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quello che stai ascoltando si fa da parte quando qualcos’altro ha bisogno delle tue orecchie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかの音に耳を傾けたいときは、再生中のものがそっと道を譲ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 소리에 귀 기울여야 할 때면, 재생 중인 것은 잠시 자리를 비켜 줍니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa sahaja yang sedang dimainkan memberi laluan apabila ada perkara lain yang perlu anda dengar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som spilles av, trer til side når noe annet trenger ørene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat er speelt, maakt plaats wanneer iets anders je oren nodig heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co gra, ustępuje miejsca, gdy Twoje uszy są potrzebne gdzie indziej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que está tocando dá passagem quando outra coisa precisa dos seus ouvidos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
