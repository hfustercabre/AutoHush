            "value" : "בלי הרשאת נגישות, AutoHush שולט ב-%@ בדרכי השליטה החלופיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐक्सेसिबिलिटी ऐक्सेस के बिना AutoHush %@ को बैकअप नियंत्रणों से नियंत्रित करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
