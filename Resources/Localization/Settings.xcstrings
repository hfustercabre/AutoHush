          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulje tai ohita se, jos se ei soi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si elle n’est pas en lecture, fermez-la ou ignorez-la."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
