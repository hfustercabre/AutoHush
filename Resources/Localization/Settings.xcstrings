        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin acceso a Accesibilidad, AutoHush controla %@ con sus controles de respaldo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilman Käyttöapu-pääsyä AutoHush ohjaa appia %@ varasäätimillä."
          }
        },
        "fr" : {
