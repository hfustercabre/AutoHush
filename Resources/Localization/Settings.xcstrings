    "It doesn’t pause itself, so it’s ignored once you choose another player." : {
      "comment" : "Settings → Sound Sources' or the menu's Ignore Another App…: the alert when the media player was chosen to ignore (it's saved as ignored, which counts once another player is chosen)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوقف نفسه مؤقتًا، لذا يتم تجاهله بمجرد اختيار مشغّل آخر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es posa en pausa a si mateix, així que s’ignora quan triïs un altre reproductor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sám sebe nepozastavuje, takže se bude ignorovat, jakmile vyberete jiný přehrávač."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den sætter ikke sig selv på pause, så den ignoreres, når du vælger en anden afspiller."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er pausiert sich nicht selbst und wird daher ignoriert, sobald du einen anderen Player wählst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν θέτει τον εαυτό του σε παύση, οπότε παραβλέπεται μόλις επιλέξετε άλλη εφαρμογή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pausa a sí mismo, así que se ignora cuando eliges otro reproductor."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pausa a sí mismo, así que se ignora cuando eliges otro reproductor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ei keskeytä itseään, joten se ohitetaan, kun valitset toisen soittimen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne se met pas en pause lui-même, il est donc ignoré dès que vous choisissez un autre lecteur."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne se met pas en pause lui-même, il est donc ignoré dès que vous choisissez un autre lecteur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוא לא משהה את עצמו, ולכן יוחרג לאחר בחירת נגן אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह खुद को पॉज़ नहीं करता, इसलिए दूसरा प्लेयर चुनते ही इसे अनदेखा किया जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne pauzira sam sebe, pa se zanemaruje čim odaberete drugi reproduktor."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem szünetelteti saját magát, ezért mellőzve lesz, amint másik lejátszót választ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemutar ini tidak menjeda dirinya sendiri, jadi akan diabaikan setelah Anda memilih pemutar lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non mette in pausa sé stesso, quindi viene ignorato quando scegli un altro lettore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分自身を一時停止しないため、別のプレーヤーを選択すると無視されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스스로 일시 정지하지 않으므로, 다른 플레이어를 선택하면 무시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ia tidak menjeda dirinya sendiri, jadi ia diabaikan sebaik sahaja anda memilih pemain lain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den setter ikke seg selv på pause, så den ignoreres når du velger en annen spiller."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die pauzeert zichzelf niet en wordt dus genegeerd zodra je een andere speler kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie wstrzymuje sam siebie, więc jest ignorowany, gdy wybierzesz inny odtwarzacz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele não se pausa sozinho, então é ignorado quando você escolhe outro player."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não se coloca em pausa a si próprio, por isso é ignorado quando escolher outro leitor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu se pune singur pe pauză, deci este ignorat după ce alegeți alt player."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он не ставит себя на паузу, поэтому будет игнорироваться, как только вы выберете другой плеер."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sám seba nepozastavuje, takže sa bude ignorovať, keď vyberiete iný prehrávač."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sam sebe ne zaustavi, zato se prezre, ko izberete drug predvajalnik."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den pausar inte sig själv, så den ignoreras när du väljer en annan spelare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวเล่นนี้ไม่หยุดตัวเองชั่วคราว จึงจะถูกละเว้นเมื่อคุณเลือกตัวเล่นอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendini duraklatmaz, bu nedenle başka bir oynatıcı seçtiğinizde yok sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Він не ставить себе на паузу, тож його буде ігноровано, щойно ви виберете інший програвач."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình phát này không tự tạm dừng, nên sẽ bị bỏ qua khi bạn chọn trình phát khác."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它不會自行暫停，因此在你選擇其他播放器後會被忽略。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它不会自己暂停，因此在你选择其他播放器后会被忽略。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它不會自行暫停，因此在你選擇其他播放器後會被忽略。"
          }
        }
      }
    },
    "Its backup controls are used until then, or until you choose another main control in %@." : {
      "comment" : "The menu, under “Allow <player> Automation Access…” (or Accessibility): the player's own way to be controlled isn't allowed, so AutoHush pauses and plays it by its other ways (backup controls) until it's allowed, or until the user picks another “Main control” (the pop-up in Settings → Fine-Tuning's player card). %@ is that Settings page, “Fine-Tuning”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حتى ذلك الحين، تُستخدم طرق التحكم الاحتياطية، أو إلى أن تختار طريقة تحكم رئيسية أخرى في «%@»."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els seus controls de reserva s’utilitzen fins aleshores o fins que es triï un altre control principal a «%@»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do té doby se používá záložní ovládání, nebo dokud v sekci „%@“ nezvolíte jiné hlavní ovládání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reservebetjeningen bruges indtil da, eller indtil en anden hovedbetjening vælges i ”%@”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis dahin oder bis in „%@“ eine andere Hauptsteuerung gewählt wird, wird die Ersatzsteuerung verwendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μέχρι τότε χρησιμοποιούνται οι εφεδρικοί τρόποι ελέγχου ή μέχρι να επιλέξετε άλλον κύριο τρόπο ελέγχου στο «%@»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus controles de reserva se usan hasta entonces o hasta que se elija otro control principal en «%@»."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus controles de respaldo se usan hasta entonces o hasta que se elija otro control principal en «%@»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varasäätimiä käytetään siihen asti, tai kunnes kohdassa ”%@” valitaan toinen pääsäädin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses commandes de secours sont utilisées d’ici là, ou jusqu’au choix d’une autre commande principale dans « %@ »."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses commandes de secours sont utilisées d’ici là, ou jusqu’au choix d’une autre commande principale dans « %@ »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עד אז נעשה שימוש בדרכי השליטה החלופיות, או עד שתיבחר דרך שליטה ראשית אחרת ב־“%@”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तब तक, या “%@” में कोई दूसरा मुख्य नियंत्रण चुनने तक, इसके बैकअप नियंत्रण इस्तेमाल होते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do tada se koristi rezervno upravljanje ili dok se u odjeljku „%@” ne odabere drugo glavno upravljanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Addig a tartalék vezérlők működnek, vagy amíg a(z) „%@” részben nem választ másik fő vezérlőt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sampai saat itu, atau sampai kontrol utama lain dipilih di “%@”, kontrol cadangannya digunakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I controlli di riserva si usano fino ad allora, o finché non si sceglie un altro controllo principale in «%@»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それまで、または「%@」で別のメインの操作を選ぶまでは、予備の操作を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그때까지 또는 ‘%@’에서 다른 기본 컨트롤을 선택할 때까지 예비 컨트롤을 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehingga itu, atau sehingga kawalan utama lain dipilih dalam “%@”, kawalan sandarannya digunakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reservekontrollene brukes inntil da, eller til en annen hovedkontroll velges i «%@»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tot die tijd wordt de reservebediening gebruikt, of tot er in ‘%@’ een andere hoofdbediening wordt gekozen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do tego czasu używane jest zapasowe sterowanie albo do wybrania innego głównego sterowania w sekcji „%@”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os controles de reserva são usados até lá, ou até escolher outro controle principal em “%@”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os controlos de reserva são usados até lá, ou até escolher outro controlo principal em “%@”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Până atunci se folosesc comenzile de rezervă sau până alegeți altă comandă principală în „%@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До тех пор используются резервные способы — или пока в разделе «%@» не будет выбран другой основной способ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dovtedy sa používa záložné ovládanie, alebo kým v sekcii „%@“ nezvolíte iné hlavné ovládanie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do takrat se uporablja rezervno upravljanje ali dokler v razdelku »%@« ne izberete drugega glavnega upravljanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reservreglagen används tills dess, eller tills ett annat huvudreglage väljs i ”%@”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระหว่างนี้จะใช้ตัวควบคุมสำรองแทน หรือจนกว่าจะเลือกตัวควบคุมหลักอื่นใน “%@”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O zamana kadar ya da “%@” bölümünde başka bir ana denetim seçilene kadar yedek denetimler kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До того часу використовуються резервні способи, або доки в розділі «%@» не буде вибрано інший основний спосіб."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong lúc đó, các điều khiển dự phòng được dùng, hoặc cho đến khi chọn điều khiển chính khác trong “%@”."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此之前，或在「%@」中選擇其他主要控制方式之前，會使用備用控制方式。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此之前，或在“%@”中选择其他主要控制方式之前，将使用备用控制方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此之前，或在「%@」中選擇其他主要控制方式之前，會使用備用控制方式。"
          }
        }
      }
