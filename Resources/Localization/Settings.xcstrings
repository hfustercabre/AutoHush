    "%@ doesn’t identify itself as Mac apps do, so AutoHush can’t tell when it plays." : {
      "comment" : "Settings → Sound Sources' or the menu's Ignore Another App…: the alert when the chosen app has no bundle identifier (the ID a Mac app has, which AutoHush tells apps' sound apart by); %@ is the app's name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يعرّف %@ نفسه كما تفعل تطبيقات Mac، لذا لا يستطيع AutoHush معرفة متى يشغّل الصوت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no s’identifica com ho fan les apps del Mac, així que l’AutoHush no pot saber quan sona."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace %@ se neidentifikuje jako aplikace pro Mac, takže AutoHush nepozná, kdy přehrává zvuk."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ identificerer sig ikke, som Mac-apps gør, så AutoHush kan ikke se, hvornår den afspiller lyd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ weist sich nicht wie Mac-Apps aus, daher kann AutoHush nicht erkennen, wann die App etwas wiedergibt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ δεν ταυτοποιείται όπως οι εφαρμογές Mac, οπότε το AutoHush δεν μπορεί να καταλάβει πότε αναπαράγει ήχο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se identifica como lo hacen las apps del Mac, así que AutoHush no puede saber cuándo suena."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se identifica como lo hacen las apps de Mac, así que AutoHush no puede saber cuándo suena."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohjelma %@ ei tunnistaudu kuten Mac-apit, joten AutoHush ei tiedä, milloin se toistaa ääntä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne s’identifie pas comme le font les apps Mac, AutoHush ne peut donc pas savoir quand elle émet du son."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne s’identifie pas comme le font les apps Mac, AutoHush ne peut donc pas savoir quand elle émet du son."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ לא מזדהה כמו אפליקציות Mac, ולכן AutoHush לא יכול לדעת מתי הוא מנגן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Mac ऐप्स की तरह अपनी पहचान नहीं बताता, इसलिए AutoHush यह नहीं जान सकता कि वह कब आवाज़ चलाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija %@ ne identificira se kao aplikacije za Mac, pa AutoHush ne može prepoznati kada reproducira zvuk."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ nem azonosítja magát úgy, ahogy a Mac-appok, ezért az AutoHush nem tudja megállapítani, mikor játszik le hangot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak mengidentifikasi diri seperti app Mac, jadi AutoHush tidak dapat mengetahui kapan app ini memutar suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non si identifica come fanno le app per Mac, quindi AutoHush non può sapere quando riproduce audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はMacのAppのように自身を識別しないため、AutoHushはいつ音を再生しているかを判断できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 앱은 Mac 앱처럼 자신을 식별하지 않기 때문에 AutoHush가 언제 소리를 재생하는지 알 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak mengenal pasti dirinya seperti app Mac, jadi AutoHush tidak dapat mengetahui bila ia bermain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ identifiserer seg ikke slik Mac-apper gjør, så AutoHush kan ikke se når den spiller av lyd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ identificeert zich niet zoals Mac-apps, dus AutoHush kan niet zien wanneer het geluid afspeelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja %@ nie identyfikuje się tak jak aplikacje na Maca, więc AutoHush nie może rozpoznać, kiedy odtwarza dźwięk."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não se identifica como os apps para Mac, então o AutoHush não consegue saber quando ele toca."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não se identifica como as apps para Mac, por isso o AutoHush não consegue saber quando reproduz som."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicația %@ nu se identifică așa cum o fac aplicațiile Mac, așa că AutoHush nu poate ști când redă sunet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Программа %@ не идентифицирует себя так, как приложения для Mac, поэтому AutoHush не может определить, когда она воспроизводит звук."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apka %@ sa neidentifikuje ako apky pre Mac, takže AutoHush nevie rozpoznať, kedy prehráva zvuk."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija %@ se ne predstavi tako kot aplikacije za Mac, zato AutoHush ne more ugotoviti, kdaj predvaja zvok."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ identifierar sig inte som Mac-appar gör, så AutoHush kan inte avgöra när den spelar upp ljud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ไม่ได้ระบุตัวตนแบบที่แอป Mac ทำ AutoHush จึงไม่รู้ว่าแอปนี้เล่นเมื่อใด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, Mac uygulamaları gibi kendini tanıtmıyor; bu yüzden AutoHush ne zaman ses çaldığını anlayamıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програма %@ не ідентифікує себе так, як програми для Mac, тому AutoHush не може визначити, коли вона відтворює звук."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không tự nhận dạng như các ứng dụng Mac, nên AutoHush không thể biết khi nào ứng dụng này phát âm thanh."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不像 Mac App 那樣識別自身，因此 AutoHush 無法判斷它何時在播放聲音。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不像 Mac App 那样标识自身，因此 AutoHush 无法判断它何时在播放声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不像 Mac App 那樣識別自身，因此 AutoHush 無法判斷它何時在播放聲音。"
          }
        }
      }
    },
    "%@ don’t identify themselves as Mac apps do, so AutoHush can’t tell when they play." : {
      "comment" : "Settings → Sound Sources' or the menu's Ignore Another App…: the alert when several chosen apps have no bundle identifier (the ID a Mac app has, which AutoHush tells apps' sound apart by); %@ is their names, already joined as a list (“A, B and C”)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
