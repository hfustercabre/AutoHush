        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa rekaman audio, app diam dengan suara terbuka membuat pemutar Anda tetap dijeda. Audio tidak pernah direkam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza la registrazione audio, un’app silenziosa con l’audio aperto tiene il lettore in pausa. L’audio non viene mai registrato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオ録音がないと、サウンドを開いたままの無音のアプリがプレーヤーを一時停止したままにします。オーディオは録音されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
