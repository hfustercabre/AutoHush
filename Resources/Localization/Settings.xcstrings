          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush צריך הקלטת שמע כדי לשמוע אם %@ מנגן, ומצב AntiDot לא משתמש בה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush को यह सुनने के लिए ऑडियो रिकॉर्डिंग चाहिए कि %@ चल रहा है या नहीं, जिसे AntiDot मोड इस्तेमाल नहीं करता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush treba snimanje zvuka, koje način rada AntiDot ne koristi, da bi čuo svira li aplikacija %@."
          }
        },
        "hu" : {
