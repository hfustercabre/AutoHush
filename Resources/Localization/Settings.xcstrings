            "value" : "แอปจะแสดงที่นี่เมื่อเล่นเสียง เพิ่มได้ทันทีด้วย “%@”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamalar ses çaldıklarında burada görünür. “%@” düğmesi hemen bir tane ekler."
