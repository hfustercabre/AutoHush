    "Tries another one when one fails" : {
      "comment" : "Under the switch “Use backup controls”: AutoHush tries another of the player's controls when one fails to pause or play it",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجرّب طريقة أخرى إذا فشلت إحداها"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un falla, en prova un altre"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkusí jiný způsob, když jeden selže"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøver en anden, hvis én fejler"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versucht eine andere, wenn eine fehlschlägt"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν ένας αποτύχει, δοκιμάζει άλλον"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba otro si uno falla"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba otro si uno falla"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kokeilee toista, jos yksi ei toimi"
