      }
    },
    "Without Accessibility access, AutoHush controls %@ by its backup controls." : {
      "comment" : "Settings → General under the media player, Settings → Media Player above the players, and Settings → Fine-Tuning's player card under “Use backup controls”: Accessibility isn't allowed, so AutoHush pauses and plays the player by its other ways (backup controls) meanwhile; %@ is the player",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون الوصول إلى تسهيلات الاستخدام، يتحكم AutoHush في %@ بطرق التحكم الاحتياطية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sense accés a Accessibilitat, l’AutoHush controla %@ amb els seus controls de reserva."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez přístupu ke Zpřístupnění ovládá AutoHush aplikaci %@ záložním ovládáním."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden adgang til Tilgængelighed styrer AutoHush %@ med reservebetjeningen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Zugriff auf „Bedienungshilfen“ steuert AutoHush %@ über die Ersatzsteuerung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς πρόσβαση στην Προσβασιμότητα, το AutoHush ελέγχει το %@ με τους εφεδρικούς τρόπους ελέγχου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin acceso a Accesibilidad, AutoHush controla %@ con sus controles de reserva."
