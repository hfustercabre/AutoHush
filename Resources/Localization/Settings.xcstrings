    "Smaller differences leave the volume as it is." : {
      "comment" : "Settings → Fine-Tuning, under “Only when quieter by”: when the other apps were less quieter than this, the Mac’s volume isn’t lowered",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفروق الأصغر تترك مستوى الصوت كما هو."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les diferències més petites deixen el volum com està."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menší rozdíly nechají hlasitost beze změny."
