            "value" : "Mennyi ideig erősödik a lejátszás a folytatás után. A 0 teljes hangerővel folytatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berapa lama pemutaran membesar kembali setelah dilanjutkan. 0 melanjutkan dengan volume penuh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto impiega la riproduzione a tornare al volume normale alla ripresa. Con 0 riprende subito a volume pieno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再開したあと、再生が元の音量に戻るまでの時間です。0にすると元の音量ですぐに再開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재개 후 재생이 원래 음량으로 돌아오는 시간입니다. 0이면 원래 음량으로 바로 재개합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempoh main balik pudar masuk semula setelah disambung semula. 0 menyambung semula pada kelantangan penuh."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor lenge avspillingen toner inn etter at den er gjenopptatt. 0 gjenopptar med fullt volum."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe lang het afspelen infadet nadat het hervat. 0 hervat op vol volume."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak długo odtwarzanie jest zgłaśniane po wznowieniu. 0 wznawia je z pełną głośnością."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto tempo a reprodução leva para voltar ao volume ao ser retomada. 0 retoma no volume normal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto tempo a reprodução demora a voltar ao volume ao ser retomada. Com 0, retoma no volume normal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât timp crește volumul redării după reluare. 0 o reia la volum maxim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько длится нарастание громкости после возобновления. 0 — сразу на полной громкости."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako dlho sa prehrávanie po obnovení zosilňuje. 0 ho obnoví na plnú hlasitosť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako dolgo predvajanje narašča po nadaljevanju. 0 ga nadaljuje s polno glasnostjo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur länge uppspelningen tonas in efter att den återupptagits. 0 återupptar med full volym."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระยะเวลาที่การเล่นจะเฟดกลับเข้าเมื่อเล่นต่อ 0 คือเล่นต่อด้วยระดับเสียงเต็ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynatma sürdürüldükten sonra sesin ne kadar sürede açılacağı. 0, tam ses düzeyiyle sürdürür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скільки триває наростання гучності після відновлення. 0 — одразу на повній гучності."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian phát lại tăng dần âm lượng sau khi tiếp tục. 0 sẽ tiếp tục ở âm lượng đầy đủ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繼續播放後恢復原本音量的時間。設為 0 會直接以原本音量繼續播放。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续播放后恢复原来音量的时间。设为 0 会直接以原来音量继续播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繼續播放後恢復原本音量的時間。設為 0 會直接以原本音量繼續播放。"
          }
        }
      }
