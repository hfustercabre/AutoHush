    "Ignored apps don’t pause your player. Select apps to remove them." : {
      "comment" : "Settings → Sound Sources, under the list; “Ignored” as the apps whose switch is off; “Select” as in clicking apps in the list (⌘-click or ⇧-click selects several)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التطبيقات المتجاهَلة لا توقف مشغّلك مؤقتًا. حدّد التطبيقات لإزالتها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps ignorades no posen en pausa el reproductor. Selecciona apps per eliminar-les."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
