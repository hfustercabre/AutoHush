            "value" : "La baisse maximale du volume du Mac quand votre lecteur reprend."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההנמכה המרבית של עוצמת הקול של ה-Mac כשהנגן שלך חוזר לנגן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका प्लेयर फिर से शुरू होने पर Mac की आवाज़ ज़्यादा से ज़्यादा इतनी कम होती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najviše koliko se glasnoća Maca smanjuje kad se vaš reproduktor nastavi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennyivel halkul legfeljebb a Mac hangereje, amikor a lejátszója folytatódik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seberapa jauh volume Mac paling banyak turun saat pemutar Anda dilanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
