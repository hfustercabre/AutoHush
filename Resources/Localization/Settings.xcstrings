            "state" : "translated",
            "value" : "Pausierte Apps zählen auch; kurze Töne nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετράνε και οι εφαρμογές σε παύση· οι σύντομοι ήχοι όχι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
