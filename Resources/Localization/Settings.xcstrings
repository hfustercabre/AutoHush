        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर ऐप हटा दिया जाता है; अनदेखे ऐप्स फिर से आपका प्लेयर पॉज़ करेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
