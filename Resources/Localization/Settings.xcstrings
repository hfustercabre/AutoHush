          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush memerlukan Rekaman audio untuk mendengar apakah %@ sedang diputar, yang tidak digunakan Mode AntiDot."
          }
        },
        "it" : {
          "stringUnit" : {
