    "Turn it on for AutoHush in System Settings, then reopen AutoHush." : {
      "comment" : "Welcome window and Settings, while Audio Recording isn't allowed",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّله لـ AutoHush في إعدادات النظام، ثم أعد فتح AutoHush."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa-ho per a l’AutoHush a Configuració del Sistema i torna a obrir l’AutoHush."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte to pro AutoHush v Nastavení systému a pak AutoHush znovu otevřete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå det til for AutoHush i Systemindstillinger, og åbn derefter AutoHush igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere AutoHush in den Systemeinstellungen und öffne AutoHush dann erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιήστε το για το AutoHush στις Ρυθμίσεις συστήματος και ανοίξτε ξανά το AutoHush."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actívalo para AutoHush en Ajustes del Sistema y vuelve a abrir AutoHush."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
