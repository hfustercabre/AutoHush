          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skiller apper som spiller, fra stille apper. Tar aldri opp noe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderscheidt spelende apps van stille. Neemt nooit iets op."
          }
        },
        "pl" : {
          "stringUnit" : {
