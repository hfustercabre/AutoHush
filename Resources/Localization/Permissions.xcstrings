    "Click Allow, then Allow again when macOS asks." : {
      "comment" : "Welcome window, under a permission macOS hasn't asked for yet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على «سماح»، ثم مرة أخرى عندما يسأل macOS."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes clic a Permet i després a Permet quan el macOS ho demani."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikněte na Povolit a pak znovu, až se macOS zeptá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik på Tillad og derefter igen, når macOS spørger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf „Erlauben“ und dann erneut, wenn macOS fragt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε κλικ στο «Να επιτρέπεται» και ξανά όταν ρωτήσει το macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en Permitir y otra vez en Permitir cuando macOS pregunte."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en Permitir y otra vez en Permitir cuando macOS pregunte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikkaa Salli ja sitten uudelleen, kun macOS kysyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur Autoriser, puis à nouveau quand macOS le demande."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur Autoriser, puis à nouveau quand macOS le demande."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש ללחוץ על “מתן הרשאה”, ואז לאשר כש-macOS שואל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमति दें पर क्लिक करें, फिर macOS के पूछने पर दोबारा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknite Dozvoli, a zatim ponovno kada macOS pita."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kattintson az Engedélyezés gombra, majd újra, amikor a macOS rákérdez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik Izinkan, lalu sekali lagi saat macOS bertanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su Consenti, poi di nuovo su Consenti quando macOS lo chiede."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「許可」をクリックし、macOSに確認されたらもう一度クリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허용을 클릭한 다음, macOS가 물어보면 다시 클릭하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik “Benarkan”, kemudian “Benarkan” sekali lagi apabila macOS bertanya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikk på Tillat, og deretter igjen når macOS spør."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op Sta toe en daarna nogmaals als macOS het vraagt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij Pozwól, a potem ponownie, gdy macOS zapyta."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em Permitir e depois em Permitir quando o macOS perguntar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em Permitir e, depois, novamente quando o macOS perguntar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faceți clic pe Permiteți, apoi din nou când întreabă macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «Разрешить», а затем ещё раз, когда macOS спросит."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
