    "AutoHush needs these to pause and resume %@ for you." : {
      "comment" : "Welcome window, at the top of the page titled “Allow AutoHush to Work”, beside the media player's icon; %@ is the media player",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج AutoHush إلى هذه الأذونات لإيقاف %@ مؤقتًا واستئنافه نيابةً عنك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’AutoHush els necessita per posar en pausa i reprendre %@ per tu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush je potřebuje, aby za vás mohl pozastavovat a obnovovat %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush skal bruge disse for at sætte %@ på pause og genoptage den for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush braucht diese Rechte, um %@ für dich zu pausieren und fortzusetzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το AutoHush τα χρειάζεται για να κάνει παύση και συνέχιση του %@ για εσάς."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush los necesita para pausar y reanudar %@ por ti."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush los necesita para pausar y reanudar %@ por ti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush tarvitsee nämä, jotta se voi keskeyttää ja jatkaa apin %@ toistoa puolestasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush en a besoin pour mettre en pause et reprendre %@ pour vous."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush en a besoin pour mettre en pause et reprendre %@ pour vous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush צריך אותן כדי להשהות ולחדש את %@ עבורך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush को आपके लिए %@ को पॉज़ और फिर से शुरू करने के लिए इनकी ज़रूरत है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHushu trebaju kako bi za vas pauzirao i nastavio %@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az AutoHushnak ezekre van szüksége, hogy szüneteltesse és folytassa Ön helyett ezt: %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush memerlukan ini untuk menjeda dan melanjutkan %@ untuk Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ne ha bisogno per mettere in pausa e riprendere %@ per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@をあなたの代わりに一時停止・再開するために、AutoHushにはこれらが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush가 사용자 대신 %@을(를) 일시 정지하고 재개하려면 이 권한이 필요합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush memerlukan ini untuk menjeda dan menyambung semula %@ untuk anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush trenger disse for å sette %@ på pause og gjenoppta den for deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush heeft deze nodig om %@ voor je te pauzeren en te hervatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush potrzebuje tych uprawnień, aby wstrzymywać i wznawiać %@ za Ciebie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush precisa disso para pausar e retomar o %@ para você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush precisa disto para pausar e retomar %@ por si."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush are nevoie de acestea pentru a pune pe pauză și a relua %@ pentru dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush нужны эти разрешения, чтобы ставить %@ на паузу и возобновлять за вас."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ich potrebuje, aby za vás mohol pozastavovať a obnovovať %@."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush jih potrebuje, da lahko namesto vas začasno ustavi in nadaljuje %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush behöver dessa för att pausa och återuppta %@ åt dig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ต้องใช้สิทธิ์เหล่านี้เพื่อหยุดพักและเล่น %@ ต่อให้คุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush, %@ uygulamasını sizin için duraklatıp sürdürmek için bunlara ihtiyaç duyar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush потрібні ці дозволи, щоб призупиняти й відновлювати %@ за вас."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush cần các quyền này để tạm dừng và tiếp tục %@ cho bạn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 需要這些權限，才能為你暫停和繼續播放 %@。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 需要这些权限，才能为你暂停和继续播放 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 需要這些權限，才能為你暫停和繼續播放 %@。"
          }
        }
      }
    },
