          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laita se päälle AutoHushille Järjestelmäasetuksissa ja avaa AutoHush sitten uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez-le pour AutoHush dans Réglages Système, puis rouvrez AutoHush."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez-le pour AutoHush dans Réglages Système, puis rouvrez AutoHush."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להפעיל אותה עבור AutoHush בהגדרות המערכת, ואז לפתוח מחדש את AutoHush."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम सेटिंग्ज़ में AutoHush के लिए इसे चालू करें, फिर AutoHush को फिर से खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uključite to za AutoHush u Postavkama sustava, a zatim ponovno otvorite AutoHush."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsolja be az AutoHushnak a Rendszerbeállításokban, majd nyissa meg újra az AutoHusht."
          }
        },
        "id" : {
