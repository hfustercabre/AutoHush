    "Pauses and resumes it for you." : {
      "comment" : "Welcome window, under “Control %@” once it's allowed",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقفه مؤقتًا ويستأنفه نيابةً عنك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El posa en pausa i el reprèn per tu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozastavuje a obnovuje ji za vás."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sætter den på pause og genoptager den for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert und setzt es für dich fort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάνει παύση και συνέχιση για εσάς."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo pausa y lo reanuda por ti."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo pausa y lo reanuda por ti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keskeyttää ja jatkaa sen puolestasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le met en pause et le reprend pour vous."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le met en pause et le reprend pour vous."
          }
        },
