    "No purple dot; a little less precise." : {
      "comment" : "Welcome window, the menu and Settings, beside or under “Use AntiDot Mode Instead”, and its help tag: AntiDot mode hides macOS's purple dot (the recording indicator shown while AutoHush measures audio), but tells playing apps a little less precisely",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلا نقطة بنفسجية؛ دقة أقل قليلًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sense punt lila; una mica menys precís."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez fialové tečky; o něco méně přesný."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen lilla prik; lidt mindre præcis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein violetter Punkt; etwas ungenauer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς μοβ κουκκίδα· λίγο λιγότερο ακριβής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin punto morado; un poco menos preciso."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin punto morado; un poco menos preciso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei violettia pistettä; hieman epätarkempi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de point violet ; un peu moins précis."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de point violet; un peu moins précis."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בלי נקודה סגולה; מעט פחות מדויק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई बैंगनी बिंदु नहीं; थोड़ा कम सटीक।"
