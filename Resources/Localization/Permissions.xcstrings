    "Tells playing apps from silent ones. Never recorded." : {
      "comment" : "Welcome window, under “Audio Recording”: what AutoHush uses it for; it only measures how loud apps play, and never records their audio",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يميز التطبيقات التي تعمل من الصامتة. لا يسجّل شيئًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingeix les apps que sonen de les silencioses. No grava res."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozlišuje aplikace, které hrají, od tichých. Nic nenahrává."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skelner apps, der spiller, fra tavse apps. Optager aldrig noget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterscheidet spielende von stummen Apps. Nimmt nichts auf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεχωρίζει τις εφαρμογές που παίζουν από τις αθόρυβες. Δεν ηχογραφεί τίποτα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue las apps que suenan de las silenciosas. No graba nada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue las apps que suenan de las silenciosas. No graba nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erottaa soivat apit hiljaisista. Ei tallenna mitään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue les apps qui jouent de celles qui sont silencieuses. N’enregistre rien."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue les apps qui jouent de celles qui sont silencieuses. N’enregistre rien."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מבחין בין אפליקציות מנגנות לשקטות. לא מקליט דבר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बज रहे ऐप्स को चुप ऐप्स से अलग करता है। कभी रिकॉर्ड नहीं करता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razlikuje aplikacije koje sviraju od tihih. Ništa ne snima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megkülönbözteti a lejátszó appokat a csendesektől. Semmit sem rögzít."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membedakan app yang memutar dari yang diam. Tidak pernah merekam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue le app che suonano da quelle silenziose. Non registra nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生中のアプリと無音のアプリを区別します。録音はしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
