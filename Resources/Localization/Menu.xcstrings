    "It can’t be paused, so it’s muted until the other apps stop." : {
      "comment" : "Help tag and VoiceOver hint of the menu's status line “Muted — Safari is playing”, for a media player that can only be muted (an app added with Add an App)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن إيقافه مؤقتًا، لذا يُكتم صوته حتى تتوقف التطبيقات الأخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es pot posar en pausa, així que queda silenciat fins que les altres apps s’aturin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelze ji pozastavit, takže je ztlumená, dokud ostatní aplikace nepřestanou hrát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den kan ikke sættes på pause, så lyden er slået fra, indtil de andre apps stopper."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er lässt sich nicht pausieren und bleibt daher stumm, bis die anderen Apps aufhören."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν μπορεί να τεθεί σε παύση, οπότε είναι σε σίγαση μέχρι να σταματήσουν οι άλλες εφαρμογές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede pausar, así que queda silenciado hasta que las demás apps paren."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede pausar, así que queda silenciado hasta que las demás apps paren."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitä ei voi keskeyttää, joten se on mykistetty, kunnes muut apit lopettavat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme il ne peut pas être mis en pause, le son est coupé jusqu’à l’arrêt des autres apps."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme il ne peut pas être mis en pause, le son est coupé jusqu’à l’arrêt des autres apps."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אי אפשר להשהות אותו, ולכן הוא מושתק עד שהאפליקציות האחרות יפסיקו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे पॉज़ नहीं किया जा सकता, इसलिए दूसरे ऐप्स के रुकने तक यह म्यूट रहता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne može se pauzirati, pa je utišana dok ostale aplikacije ne prestanu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem szüneteltethető, ezért némítva marad, amíg a többi app el nem hallgat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemutar ini tidak dapat dijeda, jadi dibisukan hingga app lain berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non può essere messo in pausa, quindi resta silenziato finché le altre app non si fermano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止できないため、ほかのAppが停止するまで消音されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 정지할 수 없으므로 다른 앱이 멈출 때까지 음소거됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ia tidak boleh dijeda, jadi ia disenyapkan sehingga app lain berhenti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den kan ikke settes på pause, så den er dempet til de andre appene stopper."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij kan niet worden gepauzeerd, dus blijft hij gedempt tot de andere apps stoppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można jej wstrzymać, więc jest wyciszona, dopóki inne aplikacje nie przestaną grać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele não pode ser pausado, então fica silenciado até os outros apps pararem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não pode ser posto em pausa, por isso fica silenciado até as outras apps pararem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu poate fi pus pe pauză, așa că rămâne fără sunet până se opresc celelalte aplicații."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его нельзя поставить на паузу, поэтому звук выключен, пока другие приложения не замолчат."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedá sa pozastaviť, takže je stlmená, kým ostatné apky neprestanú hrať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni je mogoče zaustaviti, zato je utišana, dokler druge aplikacije ne utihnejo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den kan inte pausas, så ljudet är av tills de andra apparna slutar spela."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หยุดพักแอปนี้ไม่ได้ จึงปิดเสียงไว้จนกว่าแอปอื่นจะหยุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duraklatılamıyor; bu yüzden diğer uygulamalar durana kadar sesi kapalı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Призупинити не можна, тому звук вимкнено, доки інші програми не замовкнуть."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
