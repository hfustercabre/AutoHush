    "AutoHush pauses only what plays on this Mac." : {
      "comment" : "Help tag and VoiceOver hint of the menu's status line “Playing on another device”: the media player plays on a speaker or another device",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوقف AutoHush مؤقتًا إلا ما يُشغَّل على جهاز Mac هذا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’AutoHush només posa en pausa el que sona en aquest Mac."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pozastavuje jen to, co hraje na tomto Macu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush sætter kun det på pause, der afspilles på denne Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pausiert nur, was auf diesem Mac abgespielt wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το AutoHush θέτει σε παύση μόνο ό,τι παίζει σε αυτό το Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush solo pausa lo que suena en este Mac."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush solo pausa lo que suena en esta Mac."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush keskeyttää vain sen, mitä tällä Macilla toistetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ne met en pause que ce qui est lu sur ce Mac."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ne met en pause que ce qui est lu sur ce Mac."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush משהה רק את מה שמתנגן ב-Mac זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush सिर्फ़ वही पॉज़ करता है जो इस Mac पर चल रहा है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pauzira samo ono što svira na ovom Macu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az AutoHush csak azt szünetelteti, ami ezen a Macen szól."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush hanya menjeda apa yang diputar di Mac ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mette in pausa solo ciò che viene riprodotto su questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHushが一時停止するのは、このMacで再生中のものだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush는 이 Mac에서 재생되는 항목만 일시 정지합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush hanya menjeda apa yang bermain pada Mac ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush setter bare avspilling på denne Macen på pause."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pauzeert alleen wat op deze Mac wordt afgespeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush wstrzymuje tylko to, co jest odtwarzane na tym Macu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush só pausa o que toca neste Mac."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush só põe em pausa o que toca neste Mac."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pune pe pauză doar ce se redă pe acest Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ставит на паузу только то, что звучит на этом Mac."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pozastavuje iba to, čo hrá na tomto Macu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush zaustavi samo tisto, kar se predvaja v tem Macu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush pausar bara det som spelas på den här Macen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush หยุดพักเฉพาะสิ่งที่เล่นบน Mac เครื่องนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush yalnızca bu Mac’te çalanları duraklatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush призупиняє лише те, що відтворюється на цьому Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush chỉ tạm dừng những gì phát trên máy Mac này."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 只會暫停在這部 Mac 上播放的內容。"
