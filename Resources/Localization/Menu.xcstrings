    "Nothing of it is heard, so AutoHush doesn’t pause it." : {
      "comment" : "Help tag and VoiceOver hint of the menu's status line “Playing silently”: the media player says it plays, but nothing of it is heard (a muted trailer)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُسمع منه شيء، لذا لا يوقفه AutoHush مؤقتًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se’n sent res, així que l’AutoHush no el posa en pausa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic z ní není slyšet, takže ji AutoHush nepozastavuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der høres intet fra den, så AutoHush sætter den ikke på pause."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von ihm ist nichts zu hören, daher pausiert AutoHush ihn nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ακούγεται τίποτα από αυτήν, οπότε το AutoHush δεν τη θέτει σε παύση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se oye nada, así que AutoHush no lo pausa."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se escucha nada, así que AutoHush no lo pausa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siitä ei kuulu mitään, joten AutoHush ei keskeytä sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On n’entend rien, donc AutoHush ne le met pas en pause."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On n’entend rien, donc AutoHush ne le met pas en pause."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא שומעים ממנו דבר, ולכן AutoHush לא משהה אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसकी कोई आवाज़ सुनाई नहीं देती, इसलिए AutoHush इसे पॉज़ नहीं करता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ništa se od nje ne čuje, pa je AutoHush ne pauzira."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semmi sem hallatszik belőle, ezért az AutoHush nem szünetelteti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
