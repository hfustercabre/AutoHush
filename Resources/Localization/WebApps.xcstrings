            "value" : "ל-%@ יש אתר משלו בחלק מהמדינות, ואפשר להתחבר רק לאתר של מדינת החשבון שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ की कुछ देशों में अपनी अलग साइट है, और आप सिर्फ़ अपने खाते के देश की साइट पर ही साइन इन कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ima vlastito web-mjesto u nekim državama, a prijaviti se možete samo na onom za državu vašeg računa."
          }
        },
        "hu" : {
          "stringUnit" : {
