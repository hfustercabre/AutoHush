{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ asks something before showing %@ (cookies, signing in…). AutoHush goes on once it shows." : {
      "comment" : "Add a Web App window, under the step “Answer the site in Safari”; the first %@ is the site Safari shows instead (e.g. consent.example.com), the second the one typed (e.g. music.example.com)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسأل %1$@ عن شيء قبل عرض %2$@ (ملفات تعريف الارتباط، تسجيل الدخول…). يتابع AutoHush فور عرضه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ demana alguna cosa abans de mostrar %2$@ (galetes, iniciar la sessió…). L’AutoHush continua quan es mostri."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ se před zobrazením %2$@ na něco ptá (cookies, přihlášení…). AutoHush pokračuje, jakmile se zobrazí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ spørger om noget, før %2$@ vises (cookies, log ind …). AutoHush fortsætter, så snart det vises."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ fragt etwas, bevor %2$@ angezeigt wird (Cookies, Anmeldung …). AutoHush macht weiter, sobald es angezeigt wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο ιστότοπος %1$@ ρωτά κάτι πριν εμφανιστεί ο %2$@ (cookie, σύνδεση…). Το AutoHush συνεχίζει μόλις εμφανιστεί."
          }
        },
        "en" : {
