    "If a Safari extension asks for access to the site, answer it first." : {
      "comment" : "Add a Web App window, under the step “Open it in Safari” while it's under way",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا طلب أحد ملحقات Safari الوصول إلى الموقع، فأجب عنه أولًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si una extensió del Safari demana accés al lloc, respon-li primer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud rozšíření Safari požádá o přístup k webu, nejdřív na to odpovězte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis en Safari-udvidelse beder om adgang til webstedet, så svar på den først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine Safari-Erweiterung Zugriff auf die Website anfordert, beantworte die Anfrage zuerst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν μια επέκταση του Safari ζητήσει πρόσβαση στον ιστότοπο, απαντήστε της πρώτα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si una extensión de Safari pide acceso al sitio, respóndele primero."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si una extensión de Safari pide acceso al sitio, respóndele primero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos Safari-laajennus pyytää pääsyä sivustolle, vastaa siihen ensin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si une extension Safari demande l’accès au site, répondez-y d’abord."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si une extension Safari demande l’accès au site Web, répondez-y d’abord."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם הרחבה של Safari מבקשת גישה לאתר, יש לענות לה קודם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर कोई Safari एक्सटेंशन साइट तक पहुँच माँगे, तो पहले उसका जवाब दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako proširenje za Safari zatraži pristup web-mjestu, najprije odgovorite na to."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
