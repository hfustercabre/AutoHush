        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W aplikacji %@ żaden przycisk się nie zmienił. Upewnij się, że jest wstrzymana, i ponownie kliknij „Wstrzymane”."
          }
        },
        "pt" : {
          "stringUnit" : {
