        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum botão mudou em %@. Certifique-se de que está em pausa e volte a clicar em “Em pausa”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niciun buton nu s-a schimbat în aplicația %@. Asigurați-vă că este pe pauză, apoi faceți clic din nou pe „Pe pauză”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В %@ не изменилась ни одна кнопка. Убедитесь, что воспроизведение на паузе, и снова нажмите «На паузе»."
