    "%@ has its own site in some countries, and you can sign in only on your account’s." : {
      "comment" : "Add a Web App window, under the address and the country row of a service with its own site in some countries; %@ is the service, e.g. Jukebox",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لدى %@ موقع خاص في بعض البلدان، ولا يمكنك تسجيل الدخول إلا في موقع بلد حسابك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ té un lloc propi en alguns països, i només pots iniciar la sessió en el del teu compte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ má v některých zemích vlastní web a přihlásit se můžete jen na webu země vašeho účtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har sit eget websted i nogle lande, og du kan kun logge ind på det, der hører til din konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat in manchen Ländern eine eigene Website, und du kannst dich nur auf der Website deines Accounts anmelden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η υπηρεσία %@ έχει δικό της ιστότοπο σε ορισμένες χώρες και μπορείτε να συνδεθείτε μόνο σε αυτόν της χώρας του λογαριασμού σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiene su propio sitio en algunos países, y solo puedes iniciar sesión en el de tu cuenta."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiene su propio sitio en algunos países, y solo puedes iniciar sesión en el de tu cuenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelulla %@ on oma sivustonsa joissakin maissa, ja voit kirjautua vain tilisi maan sivustolle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a son propre site dans certains pays, et vous ne pouvez vous connecter que sur celui de votre compte."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a son propre site dans certains pays, et vous ne pouvez vous connecter que sur celui de votre compte."
          }
        },
        "he" : {
