    "A minute went by without the pause. Play it again, then click It’s Playing." : {
      "comment" : "Under the step “Play something in %@” once learning went back to it: “It’s Paused” wasn't clicked within a minute",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرّت دقيقة دون إيقاف مؤقت. شغّله مرة أخرى، ثم انقر على «قيد التشغيل»."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha passat un minut sense la pausa. Torna-ho a reproduir i fes clic a «Està sonant»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uplynula minuta bez pozastavení. Pusťte to znovu a klikněte na „Hraje“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gik et minut uden pausen. Afspil det igen, og klik på ”Afspiller”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Minute ist ohne Pause vergangen. Spiele es erneut ab und klicke auf „Es läuft“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πέρασε ένα λεπτό χωρίς την παύση. Αναπαραγάγετέ το ξανά και κάντε κλικ στο «Παίζει»."
          }
        },
        "es" : {
