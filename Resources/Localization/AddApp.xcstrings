            "value" : "في كل حالات النافذة، لكنها تُفتح على الشاشة للحظة"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tots els estats de la finestra, però s’obre a la pantalla un moment"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve všech stavech okna, ale na chvíli se otevře na obrazovce"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I alle vinduestilstande, men det åbnes et øjeblik på skærmen"
          }
        },
        "de" : {
