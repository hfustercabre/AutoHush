            "value" : "Aplikace %@ se neukončila (možná se na něco ptá). Ukončete ji sami a pak to zkuste znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ blev ikke afsluttet (appen spørger måske om noget). Afslut den selv, og prøv derefter igen."
