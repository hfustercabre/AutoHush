    "%@ didn’t quit (it may be asking something). Quit it yourself, then try again." : {
      "comment" : "Add an App window, warning under the step “Reopen %@”; %@ is the app",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إنهاء %@ (ربما يطرح سؤالًا). أنهِه بنفسك، ثم أعد المحاولة."
          }
        },
        "ca" : {
          "stringUnit" : {
