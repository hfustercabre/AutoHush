    "%@ can’t be scripted, so Automation isn’t asked for." : {
      "comment" : "Add an App window, under the step “Allow what the check needs”; %@ is the app",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن التحكم في %@ عبر البرامج النصية، لذا لا يُطلب إذن التحكم التلقائي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no admet scripts, així que no es demana Automatització."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace %@ nepodporuje skripty, takže se o Automatizaci nežádá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan ikke styres med scripts, så der spørges ikke om Automatisering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist nicht skriptfähig, daher wird „Automation“ nicht angefragt."
