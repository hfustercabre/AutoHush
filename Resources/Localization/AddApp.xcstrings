    "To check again, open a window of %@ first." : {
      "comment" : "Add an App window, above “Check Again” in the last step, after a check that found the app's windows closed and a way that didn't work or couldn't be checked without a window; %@ is the app",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لإعادة الفحص، افتح أولًا نافذة من %@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per tornar a comprovar, obre abans una finestra de %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před novou kontrolou otevřete okno aplikace %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn først et vindue i %@ for at kontrollere igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne zuerst ein Fenster von %@, um erneut zu prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
