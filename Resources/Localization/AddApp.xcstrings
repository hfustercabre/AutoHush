          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počuje, či apka %@ hrá, a stlmí ju. Nič nenahráva."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sliši, ali aplikacija %@ predvaja, in jo utiša. Nikoli ne snema."
          }
        },
        "sv" : {
          "stringUnit" : {
