    "Step %lld of %lld, %@" : {
      "comment" : "VoiceOver label of a numbered step's title in the Add an App window; the first %lld is its number, the second how many steps there are; %@ is its title",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخطوة %1$lld من %2$lld، %3$@"
          }
        },
        "ca" : {
