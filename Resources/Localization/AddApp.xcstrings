        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในแต่ละสถานะ AutoHush จะหยุดพักและเล่น %@ ด้วยทุกวิธีที่ทำได้ รวมถึงแผง “กำลังเล่นอยู่” (ซึ่งจะเปิดขึ้นสักครู่)"
          }
