        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leállítva. Minden visszaállt az eredeti állapotába."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dihentikan. Semuanya dikembalikan seperti semula."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrotta. Tutto è tornato com’era."
