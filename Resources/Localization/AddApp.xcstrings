    "Hears whether %@ plays, and mutes it. Never recorded." : {
      "comment" : "Add an App window, under “Audio Recording”: what the check uses it for (it only measures how loud the app plays, and never records its audio); %@ is the app",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسمع ما إذا كان %@ يُشغّل الصوت، ويكتمه. لا يسجّل شيئًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent si %@ sona, i en silencia el so. No grava res."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slyší, jestli aplikace %@ hraje, a ztlumí ji. Nic nenahrává."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hører, om %@ afspiller, og slår lyden fra. Optager aldrig noget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hört, ob %@ abspielt, und schaltet die App stumm. Nimmt nichts auf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακούει αν παίζει η εφαρμογή %@ και τη θέτει σε σίγαση. Δεν ηχογραφεί τίποτα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oye si %@ suena y silencia su sonido. No graba nada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escucha si %@ suena y silencia su sonido. No graba nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuulee, toistaako appi %@, ja mykistää sen. Ei tallenna mitään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détecte si %@ lit du son, et le coupe. N’enregistre rien."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détecte si %@ lit du son, et le coupe. N’enregistre rien."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שומע אם %@ מנגן, ומשתיק אותו. לא מקליט דבר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुनता है कि %@ चल रहा है या नहीं, और उसे म्यूट करता है। कभी रिकॉर्ड नहीं करता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čuje svira li aplikacija %@ i utišava je. Ništa ne snima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallja, hogy szól-e a(z) %@, és lenémítja. Semmit sem rögzít."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mendengar apakah %@ memutar, dan membisukannya. Tidak pernah merekam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sente se %@ è in riproduzione e ne disattiva l’audio. Non registra nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が再生しているかを聞き取り、消音します。録音はしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 재생되는지 듣고, 음소거합니다. 녹음하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mendengar sama ada %@ bermain, dan menyenyapkannya. Tidak pernah merakam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hører om %@ spiller av, og demper den. Tar aldri opp noe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoort of %@ afspeelt en dempt de app. Neemt nooit iets op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słyszy, czy aplikacja %@ odtwarza, i wycisza ją. Niczego nie nagrywa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouve se %@ está tocando e silencia o som. Não grava nada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouve se %@ está a tocar e silencia o som. Não grava nada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
