    "Controlled the ways a check found to work." : {
      "comment" : "Where media players are offered, under the “Other Apps” heading and its “Checked by you” badge",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُتحكَّم فيها بالطرق التي وجد الفحص أنها تنجح."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es controlen amb el que va funcionar en una comprovació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovládané způsoby, které kontrola shledala funkčními."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styres på de måder, som en kontrol viste virker."
          }
        },
        "de" : {
