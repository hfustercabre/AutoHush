    "What the check found for %@ is forgotten." : {
      "comment" : "Add an App window: what Change… does once the check has run, in its question; %@ is the checked app",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنسى ما وجده الفحص لـ %@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’oblida el que la comprovació ha trobat per a %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co kontrola zjistila o aplikaci %@, se zapomene."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det, kontrollen fandt for %@, glemmes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was die Prüfung für %@ gefunden hat, wird verworfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσα βρήκε ο έλεγχος για την εφαρμογή %@ ξεχνιούνται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se olvida lo que la comprobación encontró para %@."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se olvida lo que la verificación encontró para %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkistuksen löydökset apista %@ unohdetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que la vérification a trouvé pour %@ est oublié."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que la vérification a trouvé pour %@ est oublié."
          }
        },
        "he" : {
