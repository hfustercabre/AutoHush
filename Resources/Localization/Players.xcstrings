            "value" : "Se controlan con lo que funcionó en una verificación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohjataan tavoilla, jotka tarkistus totesi toimiviksi."
          }
        },
        "fr" : {
