    "AutoHush can’t find Play/Pause in %@’s menus." : {
      "comment" : "Why the media player couldn't be controlled: an update may have changed its menus; %@ is the player",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يجد AutoHush أمر التشغيل/الإيقاف المؤقت في قوائم %@."
          }
        },
        "ca" : {
