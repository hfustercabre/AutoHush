        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush steruje aplikacją %1$@ przez „Teraz odtwarzane” na pasku menu, które jest ukryte: pokaż je (%2$@)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush controla %1$@ com “Reproduzindo” na barra de menus, que está oculto: mostre-o em %2$@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AutoHush controla %1$@ com “A reproduzir” na barra de menus, que está oculto: mostre-o em %2$@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush controlează aplicația %1$@ prin „În redare” din bara de meniu, care e ascuns: afișați-l (%2$@)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush управляет приложением %1$@ через «Исполняется» в строке меню, но оно скрыто: покажите его (%2$@)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ovláda apku %1$@ cez „Práve hrá“ na lište ponúk, ktoré je skryté: zobrazte ho (%2$@)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush upravlja aplikacijo %1$@ prek »Predvaja se« v menijski vrstici, ki je skrit: prikažite ga (%2$@)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush styr %1$@ med ”Spelas nu” i menyraden, som är dolt: visa det i %2$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ควบคุม %1$@ ด้วย “กำลังเล่นอยู่” ในแถบเมนู ซึ่งถูกซ่อนอยู่: แสดงรายการนี้ใน %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush, %1$@ uygulamasını menü çubuğundaki Şu An Çalan ile kontrol eder ama bu gizli: %2$@ bölümünde gösterin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush керує програмою %1$@ через «Зараз відтворюється» на смузі меню, що приховано: покажіть його (%2$@)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush điều khiển %1$@ bằng Đang phát trên thanh menu, mục này đang bị ẩn: hãy hiển thị trong %2$@."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush 透過選單列的「正在播放」控制 %1$@，但它已隱藏：請在%2$@中顯示它。"
