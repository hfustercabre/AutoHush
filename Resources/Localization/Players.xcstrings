    "AutoHush controls %@ with Now Playing in the menu bar, which is hidden: show it in %@." : {
      "comment" : "Why the media player (added with Add an App, paused and played through the menu bar's Now Playing panel) couldn't be paused or resumed; the first %@ is the player, the second where the setting is, e.g. “System Settings → Menu Bar”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحكم AutoHush في ‏%1$@ عبر «قيد التشغيل الآن» في شريط القوائم، وهو مخفي: أظهره من %2$@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’AutoHush controla %1$@ amb «Està sonant» de la barra de menús, que està amagat: mostra’l a %2$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ovládá aplikaci %1$@ přes „Právě hraje“ na řádku nabídek, které je skryté: zobrazte ho (%2$@)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush styrer %1$@ med ”Afspilles nu” på menulinjen, som er skjult: vis det i %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush steuert %1$@ über „Jetzt läuft“ in der Menüleiste, das ausgeblendet ist: Blende es unter %2$@ ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το AutoHush ελέγχει το %1$@ με το «Παίζει τώρα» της γραμμής μενού, που είναι κρυφό: εμφανίστε το (%2$@)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AutoHush controls %1$@ with Now Playing in the menu bar, which is hidden: show it in %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush controla %1$@ con «Ahora suena» de la barra de menús, que está oculto: muéstralo en %2$@."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush controla %1$@ con «Ahora suena» de la barra de menús, que está oculto: muéstralo en %2$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush ohjaa sovellusta %1$@ valikkorivin Toistossa-paneelilla, joka on piilotettu: näytä se kohdassa %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush contrôle %1$@ avec « À l’écoute » dans la barre des menus, qui est masqué : affichez-le dans %2$@."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush contrôle %1$@ avec « À l’écoute » dans la barre des menus, qui est masqué : affichez-le dans %2$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush שולט על %1$@ דרך “מתנגן כעת” בשורת התפריטים, שמוסתר: יש להציג אותו דרך %2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush, %1$@ को मेनू बार के “अभी चल रहा है” से नियंत्रित करता है, जो छिपा है: इसे %2$@ में दिखाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush upravlja aplikacijom %1$@ preko „Izvodi se” u traci s izbornicima, što je skriveno: prikažite ga (%2$@)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az AutoHush a menüsor „Lejátszás alatt” paneljével vezérli a(z) %1$@ appot, de az el van rejtve: jelenítse meg (%2$@)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mengontrol %1$@ dengan Sedang Diputar di bar menu, yang disembunyikan: tampilkan di %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush controlla %1$@ con «In riproduzione» nella barra dei menu, che è nascosto: mostralo in %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHushはメニューバーの“再生中”で%1$@を操作しますが、非表示になっています。%2$@で表示してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush는 메뉴 막대의 ‘지금 재생 중’으로 %1$@을(를) 제어하지만, 이 항목이 가려져 있습니다. %2$@에서 표시하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush mengawal %1$@ dengan Kini Dimainkan dalam bar menu, yang tersembunyi: tunjukkannya dalam %2$@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
