          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush bestuurt %1$@ met ‘Wordt nu afgespeeld’ in de menubalk, dat verborgen is: toon het bij %2$@."
          }
