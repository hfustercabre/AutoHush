          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush la instala cuando no tiene tu reproductor en pausa y te avisa después."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoHush asentaa päivityksen, kun se ei pidä soitintasi keskeytettynä, ja kertoo siitä jälkeenpäin."
          }
        },
        "fr" : {
          "stringUnit" : {
