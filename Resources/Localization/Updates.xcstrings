    "AutoHush downloads it and lets you know. It keeps the download for 7 days." : {
      "comment" : "Settings → About: help tag and VoiceOver hint of the update pop-up while Download it and notify me is chosen",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنزّل AutoHush التحديث ويُعلمك. ويحتفظ بالتنزيل 7 أيام."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
