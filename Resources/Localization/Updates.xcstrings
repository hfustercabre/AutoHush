    "You have version %@, and Get release candidates is off. Download this release from GitHub and replace AutoHush in Applications." : {
      "comment" : "Update alert where AutoHush can't update itself, offering the latest release, older than the release candidate running, after Get release candidates (a setting) was turned off; %@ is the installed version. Applications is the Applications folder",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لديك الإصدار %@، و«الحصول على الإصدارات المرشّحة» متوقف. نزّل هذا الإصدار من GitHub واستبدل AutoHush في مجلد «التطبيقات»."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens la versió %@ i «Obtén versions candidates» està desactivat. Baixa aquesta versió de GitHub i substitueix l’AutoHush a Aplicacions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máte verzi %@ a volba „Získávat kandidátské verze“ je vypnutá. Stáhněte si toto vydání z GitHubu a nahraďte AutoHush ve složce Aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har version %@, og ”Hent udgivelseskandidater” er slået fra. Hent denne udgivelse fra GitHub, og erstat AutoHush i din Apps-mappe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast Version %@, und „Release Candidates erhalten“ ist aus. Lade diese Version von GitHub und ersetze AutoHush im Ordner „Programme“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχετε την έκδοση %@ και η επιλογή «Λήψη υποψήφιων εκδόσεων» είναι απενεργοποιημένη. Λάβετε αυτήν την έκδοση από το GitHub και αντικαταστήστε το AutoHush στον φάκελο «Εφαρμογές»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes la versión %@ y «Obtener versiones candidatas» está desactivado. Descarga esta versión de GitHub y sustituye AutoHush en Aplicaciones."
          }
        },
        "es-419" : {
