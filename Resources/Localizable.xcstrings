    "Grant Automation access to control %@" : {
      "comment" : "Status line; %@ is the music player, e.g. Spotify",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concedeix l'accés d'Automatització per controlar %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Zugriff auf „Automation“, um %@ zu steuern"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concede el acceso de Automatización para controlar %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l'accès « Automatisation » pour contrôler %@"
          }
        },
        "it" : {
