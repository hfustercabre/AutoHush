    "About AutoHush" : {
      "comment" : "Menu item",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobre AutoHush"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acerca de AutoHush"
          }
        }
      }
    },
