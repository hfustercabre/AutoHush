    "Grant Automation access to control %@" : {
      "comment" : "Status line; %@ is the music player, e.g. Spotify",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concedeix l'accés d'Automatització per controlar %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
