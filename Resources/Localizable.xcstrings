      "comment" : "Settings tab",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avançat"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanzado"
          }
        }
      }
    },
    "Allow %@ Automation Access…" : {
      "comment" : "Menu item; %@ is the music player, e.g. Spotify",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet l'accés d'Automatització a %@…"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir el acceso de Automatización a %@…"
          }
        }
      }
    },
    "Allow Audio Recording Access…" : {
      "comment" : "Menu item",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet l'accés a la gravació d'àudio…"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir el acceso a la grabación de audio…"
          }
        }
      }
    },
    "An app counts as playing while it tells macOS it is playing, and as paused once it stops, even with its audio still open. Apps that never tell macOS count while their audio is open." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una app compta com a reproduint mentre indica a macOS que reprodueix, i com a en pausa tan bon punt deixa de fer-ho, encara que l'àudio continuï obert. Les apps que mai ho indiquen a macOS compten mentre tenen l'àudio obert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una app cuenta como en reproducción mientras indica a macOS que está reproduciendo, y como en pausa en cuanto deja de hacerlo, aunque su audio siga abierto. Las apps que nunca lo indican a macOS cuentan mientras tienen el audio abierto."
          }
        }
      }
    },
    "An extra delay once every other app has stopped." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un retard addicional quan totes les altres apps s'han aturat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un retardo adicional cuando todas las demás apps se han detenido."
          }
        }
      }
    },
    "AntiDot mode" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode AntiDot"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo AntiDot"
          }
        }
      }
    },
    "Any app with its audio open counts as playing, even when paused." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualsevol app amb l'àudio obert compta com a reproduint, encara que estigui en pausa."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier app con el audio abierto cuenta como en reproducción, aunque esté en pausa."
          }
        }
      }
    },
    "Apps" : {
      "comment" : "Settings tab: which apps pause the music",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps"
          }
        }
      }
    },
    "Apps appear here once they have played audio." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps apareixen aquí quan han reproduït àudio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps aparecen aquí cuando han reproducido audio."
          }
        }
      }
    },
