        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sonido más bajo cuenta como silencio. Solo se usa al medir los niveles de audio (modo AntiDot desactivado)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un son plus faible compte comme du silence. Utilisé uniquement lors de la mesure des niveaux audio (mode AntiDot désactivé)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un audio più basso conta come silenzio. Usata solo durante la misurazione dei livelli audio (modalità AntiDot disattivata)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これより小さい音は無音として扱われます。オーディオレベルを測定する場合（AntiDotモードがオフのとき）にのみ使用されます。"
