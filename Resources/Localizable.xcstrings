{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (%@)" : {
      "comment" : "Diagnostics: an app's name, then its bundle ID",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ and %@ are playing" : {
      "comment" : "Completes “Music paused — %@”; two apps",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sonen %1$@ i %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ and %2$@ are playing"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "suenan %1$@ y %2$@"
          }
        }
      }
    },
    "%@ and %lld other apps are playing" : {
      "comment" : "Completes “Music paused — %@”; an app, then how many others (2 or more)",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sonen %1$@ i %2$lld apps més"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ and %2$lld other apps are playing"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "suenan %1$@ y %2$lld apps más"
          }
        }
      }
    },
    "%@ control error: %@" : {
      "comment" : "Status line; the music player, then the error it reported",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
