    "Every app is removed, and apps you turned off will pause your music again. Apps reappear as they play audio." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'eliminaran totes les apps, i les que vas desactivar tornaran a posar la música en pausa. Les apps reapareixen a mesura que reprodueixen àudio."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Apps werden entfernt, und Apps, die du ausgeschaltet hast, pausieren deine Musik wieder. Apps erscheinen wieder, sobald sie Audio abspielen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todas las apps, y las que desactivaste volverán a pausar tu música. Las apps reaparecen a medida que reproducen audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les apps sont retirées, et celles que vous avez désactivées mettront de nouveau votre musique en pause. Les apps réapparaissent à mesure qu'elles lisent du son."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le app vengono rimosse, e quelle che hai disattivato metteranno di nuovo in pausa la musica. Le app ricompaiono man mano che riproducono audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのAppが削除され、オフにしたAppでも再び音楽が一時停止するようになります。Appはオーディオを再生すると再び表示されます。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os apps serão removidos, e os que você desativou voltarão a pausar sua música. Os apps reaparecem conforme reproduzem áudio."
          }
        }
      }
    },
