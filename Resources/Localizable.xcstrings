    "Pauses your music while other apps play audio, and resumes it afterwards. Works with %@." : {
      "comment" : "About panel; %@ is the music player, e.g. Spotify",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posa la música en pausa mentre altres apps reprodueixen àudio i la reprèn després. Funciona amb %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert deine Musik, während andere Apps Audio abspielen, und setzt sie danach fort. Funktioniert mit %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa tu música mientras otras apps reproducen audio y la reanuda después. Funciona con %@."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa tu música mientras otras apps reproducen audio y la reanuda después. Funciona con %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met votre musique en pause pendant que d'autres apps lisent du son, puis la reprend. Fonctionne avec %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette in pausa la musica mentre altre app riproducono audio e poi la riprende. Funziona con %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのAppがオーディオを再生している間は音楽を一時停止し、終わると再開します。%@に対応しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱이 오디오를 재생하는 동안 음악을 일시 정지하고, 끝나면 다시 재생합니다. %@와(과) 함께 작동합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa sua música enquanto outros apps reproduzem áudio e a retoma depois. Funciona com %@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa a sua música enquanto outras apps reproduzem áudio e retoma-a depois. Funciona com %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在其他 App 播放音频时暂停你的音乐，并在之后继续播放。支持 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在其他 App 播放音訊時暫停你的音樂，並在之後繼續播放。支援 %@。"
          }
        }
      }
    },
    "Quieter output counts as silence. Only used while measuring audio levels (AntiDot mode off)." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un so més fluix compta com a silenci. Només s'utilitza en mesurar els nivells d'àudio (mode AntiDot desactivat)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leiseres Audio zählt als Stille. Wird nur beim Messen der Audiopegel verwendet (AntiDot-Modus aus)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sonido más bajo cuenta como silencio. Solo se usa al medir los niveles de audio (modo AntiDot desactivado)."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sonido más bajo cuenta como silencio. Solo se usa al medir los niveles de audio (modo AntiDot desactivado)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un son plus faible compte comme du silence. Utilisé uniquement lors de la mesure des niveaux audio (mode AntiDot désactivé)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un audio più basso conta come silenzio. Usata solo durante la misurazione dei livelli audio (modalità AntiDot disattivata)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これより小さい音は無音として扱われます。オーディオレベルを測定する場合（AntiDotモードがオフのとき）にのみ使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이보다 작은 소리는 무음으로 간주됩니다. 오디오 레벨을 측정할 때만(AntiDot 모드 끔) 사용됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áudio mais baixo conta como silêncio. Usado apenas ao medir os níveis de áudio (modo AntiDot desativado)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um som mais baixo conta como silêncio. Só é usado ao medir os níveis de áudio (modo AntiDot desativado)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比此更小的声音会视为无声。仅在测量音频电平时使用（AntiDot 模式关闭）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比此更小的聲音會視為無聲。僅在測量音訊音量時使用（AntiDot 模式關閉）。"
          }
        }
      }
    },
